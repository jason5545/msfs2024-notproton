diff --git a/src/d3d11/d3d11_device.cpp b/src/d3d11/d3d11_device.cpp
index 3a26017c..846a5515 100644
--- a/src/d3d11/d3d11_device.cpp
+++ b/src/d3d11/d3d11_device.cpp
@@ -2330,6 +2330,47 @@ namespace dxvk {
       return S_FALSE;
 
 #ifdef _WIN32
+    // steamac: on devices without Win32 handle export, shared textures live in
+    // host-memory sections (DxvkHostSharedSection), from DXVK or vkd3d-proton.
+    // NT and KMT handles are both section handles there.
+    if (m_dxvkDevice->canHostShareImages()) {
+      Rc<DxvkHostSharedSection> section = DxvkHostSharedSection::open(hResource);
+
+      if (section != nullptr) {
+        const DxvkHostShareHeader* header = section->header();
+
+        D3D11_COMMON_TEXTURE_DESC d3d11Desc = { };
+        d3d11Desc.Width          = header->width;
+        d3d11Desc.Height         = header->height;
+        d3d11Desc.Depth          = 1;
+        d3d11Desc.MipLevels      = header->mipLevels;
+        d3d11Desc.ArraySize      = header->arraySize;
+        d3d11Desc.Format         = DXGI_FORMAT(header->dxgiFormat);
+        d3d11Desc.SampleDesc     = { header->sampleCount, header->sampleQuality };
+        d3d11Desc.Usage          = D3D11_USAGE(header->d3d11Usage);
+        d3d11Desc.BindFlags      = header->d3d11BindFlags;
+        d3d11Desc.CPUAccessFlags = header->d3d11CpuAccessFlags;
+        d3d11Desc.MiscFlags      = header->d3d11MiscFlags;
+        d3d11Desc.TextureLayout  = D3D11_TEXTURE_LAYOUT_UNDEFINED;
+
+        if (!(d3d11Desc.MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX)))
+          d3d11Desc.MiscFlags |= D3D11_RESOURCE_MISC_SHARED;
+
+        try {
+          const Com<D3D11Texture2D> texture = new D3D11Texture2D(this, &d3d11Desc, nullptr, hResource);
+          texture->QueryInterface(ReturnedInterface, ppResource);
+
+          Logger::info(str::format("D3D11: Opened shared texture in host memory: ", d3d11Desc.Width, "x", d3d11Desc.Height,
+            ", format ", d3d11Desc.Format, ", creator ", header->creator, ", row pitch ", header->rowPitch));
+          return S_OK;
+        }
+        catch (const DxvkError& e) {
+          Logger::err(e.message());
+          return E_INVALIDARG;
+        }
+      }
+    }
+
     HANDLE ntHandle = IsKmtHandle ? openKmtHandle(hResource) : hResource;
 
     if (ntHandle == INVALID_HANDLE_VALUE) {
diff --git a/src/d3d11/d3d11_resource.cpp b/src/d3d11/d3d11_resource.cpp
index 1648091f..763b38f4 100644
--- a/src/d3d11/d3d11_resource.cpp
+++ b/src/d3d11/d3d11_resource.cpp
@@ -84,6 +84,18 @@ namespace dxvk {
   HRESULT STDMETHODCALLTYPE D3D11DXGIKeyedMutex::AcquireSync(
           UINT64                  Key,
           DWORD                   dwMilliseconds) {
+    // steamac: host-memory shared textures have no cross-device semaphore to
+    // build a keyed mutex on. Keys are not enforced; ReleaseSync waits for the
+    // GPU so that the other device sees finished contents.
+    if (IsHostShared()) {
+      if (!m_warned) {
+        m_warned = true;
+        Logger::warn("D3D11DXGIKeyedMutex: Texture is shared through host memory, keys are not enforced");
+      }
+
+      return S_OK;
+    }
+
     if (!m_supported) {
       if (!m_warned) {
         m_warned = true;
@@ -107,6 +119,14 @@ namespace dxvk {
 
   HRESULT STDMETHODCALLTYPE D3D11DXGIKeyedMutex::ReleaseSync(
           UINT64                  Key) {
+    if (IsHostShared()) {
+      D3D11CommonTexture* texture = GetCommonTexture(m_resource);
+      D3D11ImmediateContext* context = m_device->GetContext();
+      D3D10DeviceLock lock = context->LockContext();
+      context->WaitForResource(*texture->GetImage(), DxvkCsThread::SynchronizeAll, D3D11_MAP_READ_WRITE, 0);
+      return S_OK;
+    }
+
     if (!m_supported)
       return S_OK;
 
@@ -131,6 +151,17 @@ namespace dxvk {
     return vr == VK_SUCCESS ? S_OK : DXGI_ERROR_INVALID_CALL;
   }
 
+  bool D3D11DXGIKeyedMutex::IsHostShared() const {
+    D3D11CommonTexture* texture = GetCommonTexture(m_resource);
+
+    if (!texture)
+      return false;
+
+    Rc<DxvkImage> image = texture->GetImage();
+    return image != nullptr && image->isHostShared();
+  }
+
+
   D3D11DXGIResource::D3D11DXGIResource(
           ID3D11Resource*         pResource,
           D3D11Device*            pDevice)
