+
+static inline struct vkd3d_host_share_header *vkd3d_host_share_header(const struct vkd3d_host_share *share)
+{
+    return (struct vkd3d_host_share_header *)share->view;
+}
+
+static inline void *vkd3d_host_share_data(const struct vkd3d_host_share *share)
+{
+    return share->view + vkd3d_host_share_header(share)->data_offset;
