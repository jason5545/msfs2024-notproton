 src/kosmickrisp/bridge/mtl_encoder.m       | 11 +++++++++++
 src/kosmickrisp/vulkan/kk_cmd_buffer.c     | 13 ++++++++++++-
 src/kosmickrisp/vulkan/kk_cmd_buffer.h     |  2 ++
 src/kosmickrisp/vulkan/kk_descriptor_set.c | 14 ++++++++++++--
 src/kosmickrisp/vulkan/kk_device.c         | 10 ++++++++++
 src/kosmickrisp/vulkan/kk_device.h         |  2 ++
