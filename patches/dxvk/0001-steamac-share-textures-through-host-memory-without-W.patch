--- a/src/d3d11/d3d11_texture.cpp
+++ b/src/d3d11/d3d11_texture.cpp
@@ -721,6 +721,33 @@ namespace dxvk {
   
   
   void D3D11CommonTexture::ExportImageInfo() {
+    // steamac: host-memory shared textures carry their description in the
+    // section header instead of Proton's sharedgpures metadata.
+    if (m_image->isHostShared()) {
+      DxvkHostShareHeader* header = m_image->hostSection()->header();
+      header->dxgiFormat          = m_desc.Format;
+      header->width               = m_desc.Width;
+      header->height              = m_desc.Height;
+      header->mipLevels           = m_desc.MipLevels;
+      header->arraySize           = m_desc.ArraySize;
+      header->sampleCount         = m_desc.SampleDesc.Count;
+      header->sampleQuality       = m_desc.SampleDesc.Quality;
+      header->d3d11Usage          = m_desc.Usage;
+      header->d3d11BindFlags      = m_desc.BindFlags;
+      header->d3d11CpuAccessFlags = m_desc.CPUAccessFlags;
+      header->d3d11MiscFlags      = m_desc.MiscFlags;
+      header->d3d12Flags          = 0u;
+
+      // Publish the header last, openers check the magic
+      std::atomic_thread_fence(std::memory_order_release);
+      header->magic = DxvkHostShareMagic;
+
+      Logger::info(str::format("D3D11: Shared texture in host memory: ", m_desc.Width, "x", m_desc.Height,
+        ", format ", m_desc.Format, ", bind 0x", std::hex, m_desc.BindFlags, ", misc 0x", m_desc.MiscFlags,
+        std::dec, ", row pitch ", header->rowPitch, ", ", header->dataSize, " bytes"));
+      return;
+    }
+
     HANDLE hSharedHandle;
 
     if (m_desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE)
