diff --git a/libs/vkd3d/hostshare.c b/libs/vkd3d/hostshare.c
new file mode 100644
index 00000000..0cf37afe
--- /dev/null
+++ b/libs/vkd3d/hostshare.c
@@ -0,0 +1,377 @@
+/*
+ * Shared textures through host memory (steamac).
+ *
+ * When the Vulkan device has no VK_KHR_external_memory_win32 but has VK_EXT_external_memory_host
+ * (CrossOver on macOS with KosmicKrisp), a committed texture with D3D12_HEAP_FLAG_SHARED lives in a
+ * pagefile-backed section: a header at offset 0, a LINEAR image from data_offset on, imported into
+ * each VkDevice with VK_EXT_external_memory_host. The NT handle is the section handle, and DXVK
+ * (jason5545/dxvk-steamac, src/dxvk/dxvk_shared_section.h) uses the same layout, so D3D11 and D3D12
+ * can open each other's textures. Turn it off with STEAMAC_NO_HOST_SHARING=1.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#include "vkd3d_private.h"
+
+typedef char vkd3d_host_share_header_size_check[sizeof(struct vkd3d_host_share_header) == 112 ? 1 : -1];
+
+bool d3d12_device_uses_host_sharing(struct d3d12_device *device)
+{
+    static int enabled = -1;
+    char value[16];
+
+    if (enabled < 0)
+    {
+        enabled = !(vkd3d_get_env_var("STEAMAC_NO_HOST_SHARING", value, sizeof(value)) && !strcmp(value, "1"));
+        if (!enabled)
+            INFO("Host-memory sharing disabled by STEAMAC_NO_HOST_SHARING.\n");
+    }
+
+    return enabled && device->vk_info.EXT_external_memory_host && !device->vk_info.KHR_external_memory_win32;
+}
+
+bool d3d12_resource_uses_host_sharing(const struct d3d12_resource *resource, struct d3d12_device *device)
+{
+    return (resource->heap_flags & D3D12_HEAP_FLAG_SHARED) && (resource->flags & VKD3D_RESOURCE_COMMITTED) &&
+            resource->desc.Dimension != D3D12_RESOURCE_DIMENSION_BUFFER && d3d12_device_uses_host_sharing(device);
+}
+
+bool vkd3d_host_share_create(VkDeviceSize data_size, struct vkd3d_host_share *share)
+{
+    struct vkd3d_host_share_header *header;
+    VkDeviceSize section_size;
+
+    data_size = align64(data_size, VKD3D_HOST_SHARE_GRANULARITY);
+    section_size = VKD3D_HOST_SHARE_GRANULARITY + data_size;
+
+    memset(share, 0, sizeof(*share));
+
+    if (!(share->section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+            (DWORD)(section_size >> 32), (DWORD)section_size, NULL)))
+    {
+        ERR("CreateFileMapping(%"PRIu64") failed, error %lu.\n", section_size, GetLastError());
+        return false;
+    }
+
+    if (!(share->view = MapViewOfFile(share->section, FILE_MAP_ALL_ACCESS, 0, 0, 0)))
+    {
+        ERR("MapViewOfFile failed, error %lu.\n", GetLastError());
+        CloseHandle(share->section);
+        share->section = NULL;
+        return false;
+    }
+
+    /* Pagefile-backed sections start out zeroed */
+    header = vkd3d_host_share_header(share);
+    header->header_size = sizeof(*header);
+    header->data_offset = VKD3D_HOST_SHARE_GRANULARITY;
+    header->data_size = data_size;
+    return true;
+}
+
+bool vkd3d_host_share_open(HANDLE handle, struct vkd3d_host_share *share)
+{
+    const struct vkd3d_host_share_header *header;
+    MEMORY_BASIC_INFORMATION mbi;
+    HANDLE process, dup = NULL;
+    void *view;
+
+    memset(share, 0, sizeof(*share));
+
+    if (!handle || handle == INVALID_HANDLE_VALUE)
+        return false;
+
+    process = GetCurrentProcess();
+    if (!DuplicateHandle(process, handle, process, &dup, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return false;
+
+    /* Fails cleanly for anything that is not a section */
+    if (!(view = MapViewOfFile(dup, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 0)))
+    {
+        CloseHandle(dup);
+        return false;
+    }
+
+    share->section = dup;
+    share->view = view;
+    header = vkd3d_host_share_header(share);
+
+    if (!VirtualQuery(view, &mbi, sizeof(mbi)) ||
+            mbi.RegionSize < sizeof(*header) ||
+            header->magic != VKD3D_HOST_SHARE_MAGIC ||
+            header->version != VKD3D_HOST_SHARE_VERSION ||
+            header->header_size != sizeof(*header) ||
+            header->data_offset < sizeof(*header) ||
+            header->data_offset % VKD3D_HOST_SHARE_GRANULARITY ||
+            header->data_size % VKD3D_HOST_SHARE_GRANULARITY ||
+            header->data_offset + header->data_size > mbi.RegionSize)
+    {
+        vkd3d_host_share_close(share);
+        return false;
+    }
+
+    return true;
+}
+
+void vkd3d_host_share_close(struct vkd3d_host_share *share)
+{
+    if (share->view)
+        UnmapViewOfFile(share->view);
+    if (share->section)
+        CloseHandle(share->section);
+    memset(share, 0, sizeof(*share));
+}
+
+HANDLE vkd3d_host_share_duplicate_handle(const struct vkd3d_host_share *share)
+{
+    HANDLE process = GetCurrentProcess(), dup = NULL;
+
+    if (!DuplicateHandle(process, share->section, process, &dup, 0, FALSE, DUPLICATE_SAME_ACCESS))
+        return NULL;
+
+    return dup;
+}
+
+HRESULT vkd3d_host_share_validate_desc(struct d3d12_device *device, const D3D12_RESOURCE_DESC1 *desc)
+{
+    const struct vkd3d_format *format;
+    const char *reason = NULL;
+
+    /* Host memory can only back buffer-like LINEAR images: one 2D subresource, no planes, no depth.
+     * Anything else would silently end up unshared, so refuse it. */
+    if (desc->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER)
+        return S_OK;
+
+    format = vkd3d_format_from_d3d12_resource_desc(device, desc, 0);
+
+    if (desc->Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D)
+        reason = "only 2D textures are supported";
+    else if (desc->MipLevels != 1 && !(desc->MipLevels == 0 && desc->Width == 1 && desc->Height == 1))
+        reason = "mip levels > 1 are not supported";
+    else if (desc->DepthOrArraySize != 1)
+        reason = "texture arrays are not supported";
+    else if (desc->SampleDesc.Count != 1)
+        reason = "multisampling is not supported";
+    else if (!format)
+        reason = "unknown format";
+    else if (format->plane_count > 1)
+        reason = "multi-planar formats are not supported";
+    else if (format->vk_aspect_mask != VK_IMAGE_ASPECT_COLOR_BIT || (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL))
+        reason = "depth-stencil textures are not supported";
+    else if (desc->Layout != D3D12_TEXTURE_LAYOUT_UNKNOWN)
+        reason = "only D3D12_TEXTURE_LAYOUT_UNKNOWN is supported";
+
+    if (reason)
+    {
+        ERR("Cannot create shared texture in host memory: %s (%"PRIu64"x%u, format %#x, mips %u, layers %u, samples %u, flags %#x).\n",
+                reason, desc->Width, desc->Height, desc->Format, desc->MipLevels, desc->DepthOrArraySize,
+                desc->SampleDesc.Count, desc->Flags);
+        return E_INVALIDARG;
+    }
+
+    return S_OK;
+}
+
+HRESULT vkd3d_host_share_check_image(struct d3d12_device *device, const VkImageCreateInfo *image_info)
+{
+    const struct vkd3d_vk_instance_procs *vk_procs = &device->vkd3d_instance->vk_procs;
+    VkPhysicalDeviceExternalImageFormatInfo external_info;
+    VkExternalImageFormatProperties external_properties;
+    VkPhysicalDeviceImageFormatInfo2 format_info;
+    VkImageFormatProperties2 properties;
+    VkResult vr;
+
+    memset(&external_info, 0, sizeof(external_info));
+    external_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO;
+    external_info.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+
+    memset(&format_info, 0, sizeof(format_info));
+    format_info.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2;
+    format_info.pNext = &external_info;
+    format_info.format = image_info->format;
+    format_info.type = image_info->imageType;
+    format_info.tiling = image_info->tiling;
+    format_info.usage = image_info->usage;
+    format_info.flags = image_info->flags;
+
+    memset(&external_properties, 0, sizeof(external_properties));
+    external_properties.sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES;
+
+    memset(&properties, 0, sizeof(properties));
+    properties.sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2;
+    properties.pNext = &external_properties;
+
+    vr = VK_CALL(vkGetPhysicalDeviceImageFormatProperties2(device->vk_physical_device, &format_info, &properties));
+
+    if (vr != VK_SUCCESS ||
+            !(external_properties.externalMemoryProperties.externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT) ||
+            image_info->extent.width > properties.imageFormatProperties.maxExtent.width ||
+            image_info->extent.height > properties.imageFormatProperties.maxExtent.height)
+    {
+        ERR("Cannot create shared texture in host memory: LINEAR image not supported (vr %d, format %u, %ux%u, usage %#x, flags %#x).\n",
+                vr, image_info->format, image_info->extent.width, image_info->extent.height,
+                image_info->usage, image_info->flags);
+        return E_INVALIDARG;
+    }
+
+    return S_OK;
+}
+
+void vkd3d_host_share_desc_from_header(const struct vkd3d_host_share_header *header, D3D12_RESOURCE_DESC1 *desc)
+{
+    memset(desc, 0, sizeof(*desc));
+    desc->Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc->Width = header->width;
+    desc->Height = header->height;
+    desc->DepthOrArraySize = header->array_size;
+    desc->MipLevels = header->mip_levels;
+    desc->Format = header->dxgi_format;
+    desc->SampleDesc.Count = header->sample_count;
+    desc->SampleDesc.Quality = header->sample_quality;
+    desc->Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+
+    if (header->creator == VKD3D_HOST_SHARE_CREATOR_VKD3D)
+    {
+        desc->Flags = header->d3d12_flags;
+        return;
+    }
+
+    /* Same mapping as for sharedgpures metadata in d3d12_device_OpenSharedHandle */
+    if (header->d3d11_bind_flags & D3D11_BIND_RENDER_TARGET)
+        desc->Flags |= D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    if (header->d3d11_bind_flags & D3D11_BIND_DEPTH_STENCIL)
+    {
+        desc->Flags |= D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+        if (!(header->d3d11_bind_flags & D3D11_BIND_SHADER_RESOURCE))
+            desc->Flags |= D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE;
+    }
+    else
+        desc->Flags |= D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS;
+    if (header->d3d11_bind_flags & D3D11_BIND_UNORDERED_ACCESS)
+        desc->Flags |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+}
+
+HRESULT d3d12_resource_init_host_share(struct d3d12_resource *resource, struct d3d12_device *device,
+        HANDLE shared_handle, struct vkd3d_allocate_memory_info *allocate_info)
+{
+    const VkDeviceSize host_alignment = device->device_info.external_memory_host_properties.minImportedHostPointerAlignment;
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkMemoryHostPointerPropertiesEXT host_properties;
+    const struct vkd3d_host_share_header *header;
+    VkSubresourceLayout layout;
+    VkImageSubresource subresource;
+    uint32_t type_mask;
+    VkResult vr;
+
+    if (!host_alignment || VKD3D_HOST_SHARE_GRANULARITY % host_alignment)
+    {
+        ERR("Cannot share textures in host memory: minImportedHostPointerAlignment %"PRIu64".\n", host_alignment);
+        return E_INVALIDARG;
+    }
+
+    subresource.aspectMask = resource->format->vk_aspect_mask;
+    subresource.mipLevel = 0;
+    subresource.arrayLayer = 0;
+    VK_CALL(vkGetImageSubresourceLayout(device->vk_device, resource->res.vk_image, &subresource, &layout));
+
+    if (shared_handle && shared_handle != INVALID_HANDLE_VALUE)
+    {
+        /* Import: the exporter's section must hold an image with our layout */
+        if (!vkd3d_host_share_open(shared_handle, &resource->host_share))
+        {
+            ERR("Handle %p is not a host-memory shared texture.\n", shared_handle);
+            return E_INVALIDARG;
+        }
+
+        header = vkd3d_host_share_header(&resource->host_share);
+
+        if (allocate_info->memory_requirements.size > header->data_size ||
+                layout.rowPitch != header->row_pitch || layout.offset != header->image_offset)
+        {
+            ERR("Shared texture layout differs from the exporter's: row pitch %"PRIu64" vs %"PRIu64
+                    ", offset %"PRIu64" vs %"PRIu64", size %"PRIu64" vs %"PRIu64" (exporter format %u, ours %u).\n",
+                    layout.rowPitch, header->row_pitch, layout.offset, header->image_offset,
+                    allocate_info->memory_requirements.size, header->data_size,
+                    header->vk_format, resource->format->vk_format);
+            return E_INVALIDARG;
+        }
+    }
+    else
+    {
+        if (!vkd3d_host_share_create(allocate_info->memory_requirements.size, &resource->host_share))
+            return E_OUTOFMEMORY;
+
+        header = vkd3d_host_share_header(&resource->host_share);
+    }
+
+    memset(&host_properties, 0, sizeof(host_properties));
+    host_properties.sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT;
+
+    if ((vr = VK_CALL(vkGetMemoryHostPointerPropertiesEXT(device->vk_device,
+            VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+            vkd3d_host_share_data(&resource->host_share), &host_properties))))
+    {
+        ERR("vkGetMemoryHostPointerPropertiesEXT failed, vr %d.\n", vr);
+        return hresult_from_vk_result(vr);
+    }
+
+    if (!(type_mask = allocate_info->memory_requirements.memoryTypeBits & host_properties.memoryTypeBits))
+    {
+        ERR("No memory type for shared texture: image %#x, host pointer %#x.\n",
+                allocate_info->memory_requirements.memoryTypeBits, host_properties.memoryTypeBits);
+        return E_INVALIDARG;
+    }
+
+    allocate_info->host_ptr = vkd3d_host_share_data(&resource->host_share);
+    allocate_info->memory_requirements.size = header->data_size;
+    allocate_info->memory_requirements.memoryTypeBits = type_mask;
+
+    if (!(shared_handle && shared_handle != INVALID_HANDLE_VALUE))
+    {
+        struct vkd3d_host_share_header *h = vkd3d_host_share_header(&resource->host_share);
+        const D3D12_RESOURCE_DESC1 *desc = &resource->desc;
+
+        h->version = VKD3D_HOST_SHARE_VERSION;
+        h->creator = VKD3D_HOST_SHARE_CREATOR_VKD3D;
+        h->dxgi_format = desc->Format;
+        h->width = desc->Width;
+        h->height = desc->Height;
+        h->mip_levels = 1;
+        h->array_size = 1;
+        h->sample_count = desc->SampleDesc.Count;
+        h->sample_quality = desc->SampleDesc.Quality;
+        /* D3D11 view of the texture, like the sharedgpures metadata in CreateSharedHandle */
+        h->d3d11_usage = D3D11_USAGE_DEFAULT;
+        h->d3d11_bind_flags = D3D11_BIND_SHADER_RESOURCE;
+        if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET)
+            h->d3d11_bind_flags |= D3D11_BIND_RENDER_TARGET;
+        if (desc->Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)
+            h->d3d11_bind_flags |= D3D11_BIND_UNORDERED_ACCESS;
+        if (desc->Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE)
+            h->d3d11_bind_flags &= ~D3D11_BIND_SHADER_RESOURCE;
+        h->d3d11_cpu_access_flags = 0;
+        h->d3d11_misc_flags = D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
+        h->d3d12_flags = desc->Flags;
+        h->vk_format = resource->format->vk_format;
+        h->row_pitch = layout.rowPitch;
+        h->image_offset = layout.offset;
+        h->image_size = layout.size;
+    }
+
+    return S_OK;
+}
+
+void d3d12_resource_publish_host_share(struct d3d12_resource *resource)
+{
+    struct vkd3d_host_share_header *header = vkd3d_host_share_header(&resource->host_share);
+
+    /* Openers check the magic, so set it once everything else is in place */
+    vkd3d_atomic_uint32_store_explicit(&header->magic, VKD3D_HOST_SHARE_MAGIC, vkd3d_memory_order_release);
+
+    INFO("Shared texture in host memory: %ux%u, format %#x, flags %#x, row pitch %"PRIu64", %"PRIu64" bytes.\n",
+            header->width, header->height, header->dxgi_format, header->d3d12_flags, header->row_pitch, header->data_size);
+}
