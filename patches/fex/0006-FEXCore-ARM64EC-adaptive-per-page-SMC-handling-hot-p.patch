+  // STEAMAC_SMCSTATS=1: once a second, one "steamacsmc" line through __wine_dbg_output with the process-wide SMC counters
+  // of the last second (FEXCore/Utils/SteamacSMC.h). Printed by whichever thread passes by first, never while holding
+  // CodeInvalidationMutex.
+  void (*WineDbgOut)(const char*) {};
+  std::atomic<uint32_t> LastStatsMs {0};
+  struct StatsSnapshot {
+    uint64_t Faults, BecameHot, OnHot, ValidateMiss, ReprotectSkipped, Invalidations, InvalidationsNoCode;
+  };
+  StatsSnapshot LastStats {};
+
+  void MaybePrintStats() {
+    if (!WineDbgOut) [[likely]] {
+      return;
+    }
+    const uint32_t Now = FEXCore::SteamacSMC::NowMs();
+    uint32_t Prev = LastStatsMs.load(std::memory_order_relaxed);
+    if (Now - Prev < 1000 || !LastStatsMs.compare_exchange_strong(Prev, Now, std::memory_order_relaxed)) {
+      return;
+    }
+    auto& S = FEXCore::SteamacSMC::Stats();
+    const StatsSnapshot Cur {
+      S.Faults.load(std::memory_order_relaxed),           S.BecameHot.load(std::memory_order_relaxed),
+      S.OnHot.load(std::memory_order_relaxed),            S.ValidateMiss.load(std::memory_order_relaxed),
+      S.ReprotectSkipped.load(std::memory_order_relaxed), S.Invalidations.load(std::memory_order_relaxed),
+      S.InvalidationsNoCode.load(std::memory_order_relaxed),
+    };
+    const auto Line = fextl::fmt::format("steamacsmc {:04x} ms={} faults={} became_hot={} on_hot={} hot={} vmiss={} reprot_skip={} inv={} "
+                                         "inv_nocode={}\n",
+                                         GetCurrentThreadId(), Now, Cur.Faults - LastStats.Faults, Cur.BecameHot - LastStats.BecameHot,
+                                         Cur.OnHot - LastStats.OnHot, FEXCore::SteamacSMC::HotCount(), Cur.ValidateMiss - LastStats.ValidateMiss,
+                                         Cur.ReprotectSkipped - LastStats.ReprotectSkipped, Cur.Invalidations - LastStats.Invalidations,
+                                         Cur.InvalidationsNoCode - LastStats.InvalidationsNoCode);
+    LastStats = Cur;
+    WineDbgOut(Line.c_str());
+  }
+
+  void Protect(uint64_t Address, uint64_t Size, ULONG Prot) {
+    void* TmpAddress = reinterpret_cast<void*>(Address);
+    SIZE_T TmpSize = static_cast<SIZE_T>(Size);
+    ULONG TmpProt;
+    NtProtectVirtualMemory(NtCurrentProcess(), &TmpAddress, &TmpSize, Prot, &TmpProt);
+  }
