diff --git a/src/kosmickrisp/vulkan/kk_descriptor_set.c b/src/kosmickrisp/vulkan/kk_descriptor_set.c
index ea16440de07..5577227a0b6 100644
--- a/src/kosmickrisp/vulkan/kk_descriptor_set.c
+++ b/src/kosmickrisp/vulkan/kk_descriptor_set.c
@@ -216,6 +216,16 @@ write_storage_image_view_desc(struct kk_descriptor_set *set,
    get_storage_image_view_desc(binding_layout, info, dst, dst_size);
 }
 
+static uint64_t
+kk_hb_buffer_addr(const struct kk_descriptor_set *set, uint64_t addr)
+{
+   if (addr != 0 || set->base.device == NULL)
+      return addr;
+   const struct kk_device *dev =
+      container_of(set->base.device, struct kk_device, vk);
+   return dev->null_ubo ? dev->null_ubo->gpu : 0;
+}
+
 static void
 write_buffer_desc(struct kk_descriptor_set *set,
                   const VkDescriptorBufferInfo *const info, uint32_t binding,
@@ -228,7 +238,7 @@ write_buffer_desc(struct kk_descriptor_set *set,
    assert(addr_range.range <= UINT32_MAX);
 
    const struct kk_buffer_address desc = {
-      .base_addr = addr_range.addr,
+      .base_addr = kk_hb_buffer_addr(set, addr_range.addr),
       .size = addr_range.range,
    };
    write_desc(set, binding, elem, &desc, sizeof(desc));
@@ -250,7 +260,7 @@ write_dynamic_buffer_desc(struct kk_descriptor_set *set,
    struct kk_buffer_address *desc =
       &set->dynamic_buffers[binding_layout->dynamic_buffer_index + elem];
    *desc = (struct kk_buffer_address){
-      .base_addr = addr_range.addr,
+      .base_addr = kk_hb_buffer_addr(set, addr_range.addr),
       .size = addr_range.range,
    };
 }
diff --git a/src/kosmickrisp/vulkan/kk_device.c b/src/kosmickrisp/vulkan/kk_device.c
index c3541fc295e..3f5ee065c06 100644
--- a/src/kosmickrisp/vulkan/kk_device.c
+++ b/src/kosmickrisp/vulkan/kk_device.c
@@ -434,6 +434,13 @@ kk_CreateDevice(VkPhysicalDevice physicalDevice,
       goto fail_queue;
    }
 
+   if (debug_get_bool_option("HB_KK_NO_UBO_ROBUST", false)) {
+      result = kk_alloc_bo(dev, &dev->vk.base, 65536u, 256u, &dev->null_ubo);
+      if (result != VK_SUCCESS)
+         goto fail_mem_cache;
+      memset(dev->null_ubo->cpu, 0, 65536u);
+   }
+
    result = kk_device_init_meta(dev);
    if (result != VK_SUCCESS)
       goto fail_mem_cache;
@@ -514,6 +521,9 @@ kk_DestroyDevice(VkDevice _device, const VkAllocationCallbacks *pAllocator)
    kk_oq_heap_finish(dev, &dev->occlusion_queries);
    kk_destroy_sampler_heap(dev, &dev->samplers);
 
+   if (dev->null_ubo)
+      kk_destroy_bo(dev, dev->null_ubo);
+
    /* Its shaders wait for their compiles, so before the compile pool goes */
    vk_pipeline_cache_destroy(dev->vk.mem_cache, NULL);
 
