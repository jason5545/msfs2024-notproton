diff --git a/app/Sources/NotProtonApp/Model/SteamacOverlay.swift b/app/Sources/NotProtonApp/Model/SteamacOverlay.swift
new file mode 100644
index 0000000..6557335
--- /dev/null
+++ b/app/Sources/NotProtonApp/Model/SteamacOverlay.swift
@@ -0,0 +1,166 @@
+// steamac (msfs2024-notproton): our own builds laid over the FEX runner. The payload's
+// steamac/ folder is optional; a build without it behaves exactly like upstream.
+//
+//   steamac/build    the runner build these files were made for (one line, e.g. 27.0.0.41073-fex).
+//                    Every other build is left alone: the DLLs replace Wine's own and only fit that Wine.
+//   steamac/runner/  a tree laid over the runner's CrossOver folder. Files it replaces are kept
+//                    as <name>.notproton-orig first, like the ntdll patch does.
+//   steamac/remove   runner files to take out, one relative path per line (kept as .notproton-orig).
+//
+// lib/aarch64/libMoltenVK.dylib is special: the overlay puts the Vulkan loader there, since
+// win32u dlopens that name and FEX's wine ignores DYLD_INSERT_LIBRARIES. CrossOver's own
+// MoltenVK moves to lib/aarch64/moltenvk/ with an ICD file, and the run script points
+// VK_DRIVER_FILES at it unless a game picks the vkd3d backend (KosmicKrisp), so games that
+// used MoltenVK keep it.
+//
+// .notproton-steamac in the CrossOver folder holds a digest of everything laid down; the run
+// script compares it with the prefix's record and has wine.inf rerun when it changes, so a
+// prefix's system32 copies follow the runner.
+
+import Foundation
+
+enum SteamacOverlay {
+    static let step = String(localized: "Lay the steamac components over the runner")
+    static let stampName = ".notproton-steamac"
+    static let moltenVKRelocated = "lib/aarch64/moltenvk"
+    static let loaderSlot = "lib/aarch64/libMoltenVK.dylib"
+
+    struct Content: Sendable {
+        let build: String
+        let files: [(rel: String, source: URL)]
+        let removals: [String]
+        let digest: String
+    }
+
+    static func content(payload: URL? = nil) throws -> Content? {
+        let base: URL
+        if let payload {
+            base = payload
+        } else {
+            guard let root = try? InstallPayload.root() else { return nil }
+            base = root
+        }
+        let folder = base.appending(path: "steamac")
+        let fm = FileManager.default
+        guard fm.fileExists(atPath: folder.appending(path: "build").path(percentEncoded: false)) else { return nil }
+
+        let build = try String(contentsOf: folder.appending(path: "build"), encoding: .utf8)
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        let tree = folder.appending(path: "runner")
+        var files: [(rel: String, source: URL)] = []
+        if let walker = fm.enumerator(at: tree, includingPropertiesForKeys: [.isRegularFileKey]) {
+            for case let url as URL in walker {
+                guard (try? url.resourceValues(forKeys: [.isRegularFileKey]))?.isRegularFile == true,
+                      url.lastPathComponent != ".DS_Store" else { continue }
+                let rel = String(url.standardizedFileURL.path(percentEncoded: false)
+                    .dropFirst(tree.standardizedFileURL.path(percentEncoded: false).count))
+                    .trimmingCharacters(in: CharacterSet(charactersIn: "/"))
+                files.append((rel: rel, source: url))
+            }
+        }
+        files.sort { $0.rel < $1.rel }
+
+        var removals: [String] = []
+        let removeList = folder.appending(path: "remove")
+        if let text = try? String(contentsOf: removeList, encoding: .utf8) {
+            removals = text.split(separator: "\n").map { $0.trimmingCharacters(in: .whitespaces) }
+                .filter { !$0.isEmpty && !$0.hasPrefix("#") }
+        }
+        for rel in files.map(\.rel) + removals where rel.hasPrefix("/") || rel.contains("..") {
+            throw StepFailure(step: step, detail: String(localized: "steamac names \(rel), which is outside the runner."))
+        }
+
+        var lines = ["build \(build)"]
+        for file in files { lines.append("file \(file.rel) \(try Digest.sha256(of: file.source))") }
+        for rel in removals { lines.append("remove \(rel)") }
+        let digest = Digest.sha256(of: Data(lines.joined(separator: "\n").utf8))
+        return Content(build: build, files: files, removals: removals, digest: digest)
+    }
+
+    static func applies(to build: RunnerBuild, _ content: Content) -> Bool {
+        build.id == content.build
+    }
+
+    // Returns what it wrote, relative to the CrossOver folder.
+    static func install(build: RunnerBuild, root: URL, payload: URL? = nil) throws -> [String] {
+        guard let content = try content(payload: payload), applies(to: build, content) else { return [] }
+        let fm = FileManager.default
+        var written: [String] = []
+
+        // CrossOver's MoltenVK first, before the loader takes its name.
+        let relocated = root.appending(path: "\(moltenVKRelocated)/libMoltenVK.dylib")
+        if content.files.contains(where: { $0.rel == loaderSlot }),
+           !fm.fileExists(atPath: relocated.path(percentEncoded: false)) {
+            let shipped = Clean.copy(of: root.appending(path: loaderSlot))
+            guard fm.fileExists(atPath: shipped.path(percentEncoded: false)) else {
+                throw StepFailure(step: step, detail: String(localized: "The runner has no \(loaderSlot) to keep."))
+            }
+            try atomicReplace(relocated, from: shipped, step: step)
+            // Not marked as a portability driver: the loader would then hide it from winevulkan,
+            // which never asks for portability enumeration (vkCreateInstance fails with no driver).
+            let icd = """
+            {
+                "file_format_version": "1.0.0",
+                "ICD": {
+                    "library_path": "./libMoltenVK.dylib",
+                    "api_version": "1.3.0"
+                }
+            }
+
+            """
+            try atomicReplace(root.appending(path: "\(moltenVKRelocated)/MoltenVK_icd.json"),
+                              with: Data(icd.utf8), step: step)
+            written.append("\(moltenVKRelocated)/libMoltenVK.dylib")
+        }
+
+        for file in content.files {
+            let destination = root.appending(path: file.rel)
+            if try Digest.sha256(of: file.source) == Digest.sha256IfPresent(destination) { continue }
+            if fm.fileExists(atPath: destination.path(percentEncoded: false)) {
+                try RunnerPatcher.keepClean(destination)
+            }
+            try atomicReplace(destination, from: file.source, step: step)
+            written.append(file.rel)
+        }
+
+        for rel in content.removals {
+            let target = root.appending(path: rel)
+            guard fm.fileExists(atPath: target.path(percentEncoded: false)) else { continue }
+            try RunnerPatcher.keepClean(target)
+            try fm.removeItem(at: target)
+            written.append("-\(rel)")
+        }
+
+        let stamp = root.appending(path: stampName)
+        if (try? String(contentsOf: stamp, encoding: .utf8))?.trimmingCharacters(in: .whitespacesAndNewlines)
+            != content.digest {
+            try atomicReplace(stamp, with: Data("\(content.digest)\n".utf8), step: step)
+        }
+        return written
+    }
+
+    static func verify(build: RunnerBuild, root: URL, payload: URL? = nil) -> [String] {
+        guard let content = try? content(payload: payload), applies(to: build, content) else { return [] }
+        let fm = FileManager.default
+        var wrong: [String] = []
+        for file in content.files {
+            let live = Digest.sha256IfPresent(root.appending(path: file.rel))
+            if live == nil {
+                wrong.append(String(localized: "steamac: \(file.rel) is missing"))
+            } else if live != (try? Digest.sha256(of: file.source)) {
+                wrong.append(String(localized: "steamac: \(file.rel) is out of date"))
+            }
+        }
+        for rel in content.removals where fm.fileExists(atPath: root.appending(path: rel).path(percentEncoded: false)) {
+            wrong.append(String(localized: "steamac: \(rel) should not be there"))
+        }
+        if content.files.contains(where: { $0.rel == loaderSlot }),
+           !fm.fileExists(atPath: root.appending(path: "\(moltenVKRelocated)/MoltenVK_icd.json").path(percentEncoded: false)) {
+            wrong.append(String(localized: "steamac: CrossOver's MoltenVK has not been kept"))
+        }
+        let stamp = (try? String(contentsOf: root.appending(path: stampName), encoding: .utf8))?
+            .trimmingCharacters(in: .whitespacesAndNewlines)
+        if stamp != content.digest { wrong.append(String(localized: "steamac: the runner's record is out of date")) }
+        return wrong
+    }
+}
