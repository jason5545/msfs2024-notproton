+void ContextImpl::SetGuestHWBreakpoints(FEXCore::Core::InternalThreadState* Thread, const uint64_t ExecAddr[4]) {
+  // x86 debug register emulation (steamac-dr).
+  // Runs on the thread that owns the debug registers, or on the thread that set them on a suspended target.
+  constexpr uint64_t Unarmed = ~0ULL;
+  auto Frame = Thread->CurrentFrame;
+
+  std::array<uint64_t, 8> ToInvalidate {};
+  size_t NumToInvalidate {};
+
+  {
+    // Defer guest signals while the mutex is held: a guest signal handler compiling code would otherwise deadlock on it
+    // in GetGuestHWBreakpointAddresses.
+    auto lk = GuardSignalDeferringSection(HWBreakpointMutex, Thread);
+    for (size_t i = 0; i < 4; ++i) {
+      const uint64_t Old = Frame->HWBreakpointExecAddr[i];
+      const uint64_t New = ExecAddr[i];
+      if (Old == New) {
+        continue;
+      }
+
+      if (Old != Unarmed) {
+        auto it = HWBreakpointRefs.find(Old);
+        if (it != HWBreakpointRefs.end() && --it->second == 0) {
+          HWBreakpointRefs.erase(it);
+          // The check at this address is no longer needed by any thread; recompile it without the check.
+          ToInvalidate[NumToInvalidate++] = Old;
+        }
+      }
+
+      if (New != Unarmed) {
+        if (HWBreakpointRefs[New]++ == 0) {
+          // First thread to arm this address: code compiled before now has no check here.
+          ToInvalidate[NumToInvalidate++] = New;
+        }
+      }
+
+      Frame->HWBreakpointExecAddr[i] = New;
+    }
+
+    HWBreakpointCount.store(HWBreakpointRefs.size(), std::memory_order_relaxed);
+  }
+
+  // A pending RF from before the debug registers changed must not suppress a newly armed breakpoint.
+  Frame->State.HWBreakpointResumeRIP = Unarmed;
+
+  // Invalidate outside of HWBreakpointMutex: this takes CodeInvalidationMutex, which compilation holds while it reads
+  // the breakpoint set.
+  for (size_t i = 0; i < NumToInvalidate; ++i) {
+    SyscallHandler->InvalidateGuestCodeRange(Thread, ToInvalidate[i], 1);
+  }
+}
+
+void ContextImpl::GetGuestHWBreakpointAddresses(fextl::vector<uint64_t>* Out) {
+  Out->clear();
+  if (HWBreakpointCount.load(std::memory_order_relaxed) == 0) [[likely]] {
+    return;
+  }
+
+  std::scoped_lock lk(HWBreakpointMutex);
+  for (const auto& [Address, Count] : HWBreakpointRefs) {
+    Out->push_back(Address);
+  }
+}
