+    uint32_t d3d11_misc_flags;
+    uint32_t d3d12_flags;
+    uint32_t vk_format;
+    uint32_t reserved;
+    uint64_t row_pitch;
+    uint64_t image_offset;
+    uint64_t image_size;
+};
