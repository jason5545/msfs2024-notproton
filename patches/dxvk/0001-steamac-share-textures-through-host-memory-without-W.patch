diff --git a/src/dxvk/dxvk_shared_section.cpp b/src/dxvk/dxvk_shared_section.cpp
new file mode 100644
index 00000000..e14625a1
--- /dev/null
+++ b/src/dxvk/dxvk_shared_section.cpp
@@ -0,0 +1,123 @@
+#include "dxvk_shared_section.h"
+
+#include "../util/util_env.h"
+
+namespace dxvk {
+
+  DxvkHostSharedSection::~DxvkHostSharedSection() {
+#ifdef _WIN32
+    if (m_view)
+      ::UnmapViewOfFile(m_view);
+
+    if (m_handle)
+      ::CloseHandle(m_handle);
+#endif
+  }
+
+
+  bool DxvkHostSharedSection::isEnabled() {
+    static const bool s_enabled = env::getEnvVar("STEAMAC_NO_HOST_SHARING") != "1";
+    return s_enabled;
+  }
+
+
+  Rc<DxvkHostSharedSection> DxvkHostSharedSection::create(VkDeviceSize dataSize) {
+#ifdef _WIN32
+    dataSize = align(dataSize, DxvkHostShareGranularity);
+
+    VkDeviceSize sectionSize = DxvkHostShareGranularity + dataSize;
+
+    HANDLE handle = ::CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE,
+      DWORD(sectionSize >> 32), DWORD(sectionSize), nullptr);
+
+    if (!handle) {
+      Logger::err(str::format("DxvkHostSharedSection: CreateFileMapping(", sectionSize, ") failed: ", ::GetLastError()));
+      return nullptr;
+    }
+
+    void* view = ::MapViewOfFile(handle, FILE_MAP_ALL_ACCESS, 0, 0, 0);
+
+    if (!view) {
+      Logger::err(str::format("DxvkHostSharedSection: MapViewOfFile failed: ", ::GetLastError()));
+      ::CloseHandle(handle);
+      return nullptr;
+    }
+
+    Rc<DxvkHostSharedSection> section = new DxvkHostSharedSection();
+    section->m_handle = handle;
+    section->m_view = reinterpret_cast<char*>(view);
+
+    // Pagefile-backed sections start out zeroed
+    DxvkHostShareHeader* header = section->header();
+    header->headerSize = sizeof(DxvkHostShareHeader);
+    header->dataOffset = DxvkHostShareGranularity;
+    header->dataSize = dataSize;
+    return section;
+#else
+    return nullptr;
+#endif
+  }
+
+
+  Rc<DxvkHostSharedSection> DxvkHostSharedSection::open(HANDLE handle) {
+#ifdef _WIN32
+    if (!handle || handle == INVALID_HANDLE_VALUE)
+      return nullptr;
+
+    HANDLE process = ::GetCurrentProcess();
+    HANDLE dup = nullptr;
+
+    if (!::DuplicateHandle(process, handle, process, &dup, 0, FALSE, DUPLICATE_SAME_ACCESS))
+      return nullptr;
+
+    // Fails cleanly for anything that is not a section
+    void* view = ::MapViewOfFile(dup, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 0);
+
+    if (!view) {
+      ::CloseHandle(dup);
+      return nullptr;
+    }
+
+    Rc<DxvkHostSharedSection> section = new DxvkHostSharedSection();
+    section->m_handle = dup;
+    section->m_view = reinterpret_cast<char*>(view);
+
+    MEMORY_BASIC_INFORMATION mbi = { };
+
+    if (!::VirtualQuery(view, &mbi, sizeof(mbi)))
+      return nullptr;
+
+    const DxvkHostShareHeader* header = section->header();
+
+    if (mbi.RegionSize < sizeof(DxvkHostShareHeader)
+     || header->magic != DxvkHostShareMagic
+     || header->version != DxvkHostShareVersion
+     || header->headerSize != sizeof(DxvkHostShareHeader)
+     || header->dataOffset < sizeof(DxvkHostShareHeader)
+     || header->dataOffset % DxvkHostShareGranularity
+     || header->dataSize % DxvkHostShareGranularity
+     || header->dataOffset + header->dataSize > mbi.RegionSize)
+      return nullptr;
+
+    return section;
+#else
+    return nullptr;
+#endif
+  }
+
+
+  HANDLE DxvkHostSharedSection::duplicateHandle() const {
+#ifdef _WIN32
+    HANDLE process = ::GetCurrentProcess();
+    HANDLE dup = nullptr;
+
+    if (!::DuplicateHandle(process, m_handle, process, &dup, 0, FALSE, DUPLICATE_SAME_ACCESS))
+      return INVALID_HANDLE_VALUE;
+
+    return dup;
+#else
+    return INVALID_HANDLE_VALUE;
+#endif
+  }
+
+}
diff --git a/src/dxvk/dxvk_shared_section.h b/src/dxvk/dxvk_shared_section.h
new file mode 100644
index 00000000..820e1047
--- /dev/null
+++ b/src/dxvk/dxvk_shared_section.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include "dxvk_include.h"
+
+namespace dxvk {
+
+  /**
+   * \brief Header of a host-memory shared texture
+   *
+   * Used when the Vulkan device has no VK_KHR_external_memory_win32 but has
+   * VK_EXT_external_memory_host (CrossOver on macOS with KosmicKrisp). The
+   * texture lives in a pagefile-backed section: this header at offset 0, the
+   * LINEAR image from \c dataOffset on, imported into each VkDevice with
+   * VK_EXT_external_memory_host. The NT handle of the texture is the section
+   * handle. vkd3d-proton (jason5545/vkd3d-proton-steamac, libs/vkd3d/hostshare.c)
+   * reads and writes the same layout, so keep both in sync.
+   */
+  struct DxvkHostShareHeader {
+    uint32_t magic;               ///< DxvkHostShareMagic
+    uint32_t version;             ///< DxvkHostShareVersion
+    uint32_t headerSize;          ///< sizeof(DxvkHostShareHeader)
+    uint32_t creator;             ///< 1: DXVK (D3D11), 2: vkd3d-proton (D3D12)
+    uint64_t dataOffset;          ///< Offset of the image memory in the section
+    uint64_t dataSize;            ///< Size of the imported range, multiple of 64 KiB
+    uint32_t dxgiFormat;
+    uint32_t width;
+    uint32_t height;
+    uint32_t mipLevels;
+    uint32_t arraySize;
+    uint32_t sampleCount;
+    uint32_t sampleQuality;
+    uint32_t d3d11Usage;
+    uint32_t d3d11BindFlags;
+    uint32_t d3d11CpuAccessFlags;
+    uint32_t d3d11MiscFlags;
+    uint32_t d3d12Flags;          ///< D3D12_RESOURCE_FLAGS of a vkd3d-proton texture
+    uint32_t vkFormat;            ///< Format of the exporter's VkImage
+    uint32_t reserved;
+    uint64_t rowPitch;            ///< Exporter's VkSubresourceLayout of mip 0, layer 0
+    uint64_t imageOffset;
+    uint64_t imageSize;
+  };
+
+  static_assert(sizeof(DxvkHostShareHeader) == 112);
+
+  constexpr uint32_t     DxvkHostShareMagic      = 0x53485453u; // "STHS"
+  constexpr uint32_t     DxvkHostShareVersion    = 1u;
+  constexpr uint32_t     DxvkHostShareCreatorDxvk = 1u;
+  constexpr VkDeviceSize DxvkHostShareGranularity = 65536u;
+
+  /**
+   * \brief Section backing a host-memory shared texture
+   *
+   * Owns one handle to the section and one view of it. The view stays mapped
+   * until the last reference goes away, which must happen after the Vulkan
+   * memory imported from it has been freed.
+   */
+  class DxvkHostSharedSection : public RcObject {
+
+  public:
+
+    ~DxvkHostSharedSection();
+
+    /**
+     * \brief Whether host-memory sharing is allowed
+     *
+     * \c STEAMAC_NO_HOST_SHARING=1 turns the path off for comparisons.
+     */
+    static bool isEnabled();
+
+    /**
+     * \brief Creates a new section for an exported texture
+     *
+     * \param [in] dataSize Image memory size, rounded up to 64 KiB here
+     * \returns The section with an empty header, or \c nullptr
+     */
+    static Rc<DxvkHostSharedSection> create(VkDeviceSize dataSize);
+
+    /**
+     * \brief Opens a section from an NT or KMT handle
+     *
+     * Duplicates the handle, so the caller keeps ownership of its own.
+     * \returns The section, or \c nullptr if the handle is not a section
+     *    with a valid header (e.g. a handle from a different sharing path)
+     */
+    static Rc<DxvkHostSharedSection> open(HANDLE handle);
+
+    HANDLE handle() const {
+      return m_handle;
+    }
+
+    DxvkHostShareHeader* header() const {
+      return reinterpret_cast<DxvkHostShareHeader*>(m_view);
+    }
+
+    void* data() const {
+      return m_view + header()->dataOffset;
+    }
+
+    VkDeviceSize dataSize() const {
+      return header()->dataSize;
+    }
+
+    /**
+     * \brief Creates a new handle to the section for the application
+     * \returns New handle, or \c INVALID_HANDLE_VALUE
+     */
+    HANDLE duplicateHandle() const;
+
+  private:
+
+    HANDLE  m_handle   = nullptr;
+    char*   m_view     = nullptr;
+
+  };
+
+}
