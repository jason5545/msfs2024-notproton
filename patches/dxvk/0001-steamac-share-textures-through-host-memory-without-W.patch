+  Rc<DxvkResourceAllocation> DxvkMemoryAllocator::createHostSharedImageResource(
+    const VkImageCreateInfo&          createInfo,
+    const DxvkAllocationInfo&         allocationInfo,
+          DxvkHostSharedSection*      importSection) {
+    auto vk = m_device->vkd();
+
+    VkImage image = VK_NULL_HANDLE;
+    VkResult vr = vk->vkCreateImage(vk->device(), &createInfo, nullptr, &image);
+
+    if (vr != VK_SUCCESS) {
+      throw DxvkError(str::format("Failed to create host-shared image: ", vr,
+        "\n  format:  ", createInfo.format,
+        "\n  extent:  ", createInfo.extent.width, "x", createInfo.extent.height,
+        "\n  usage:   ", std::hex, createInfo.usage,
+        "\n  flags:   ", createInfo.flags));
+    }
+
+    VkMemoryRequirements requirements = { };
+    vk->vkGetImageMemoryRequirements(vk->device(), image, &requirements);
+
+    VkImageSubresource subresource = { lookupFormatInfo(createInfo.format)->aspectMask, 0u, 0u };
+    VkSubresourceLayout layout = { };
+    vk->vkGetImageSubresourceLayout(vk->device(), image, &subresource, &layout);
+
+    // Exports get a new section sized for the image. Imports use the
+    // exporter's section, which must hold an image with the same layout.
+    Rc<DxvkHostSharedSection> section = importSection;
+    std::string error;
+
+    VkDeviceSize hostAlignment = m_device->properties().extExternalMemoryHost.minImportedHostPointerAlignment;
+
+    if (!hostAlignment || DxvkHostShareGranularity % hostAlignment)
+      error = str::format("minImportedHostPointerAlignment ", hostAlignment, " does not divide 64 KiB");
+
+    if (error.empty() && !section) {
+      section = DxvkHostSharedSection::create(requirements.size);
+
+      if (!section)
+        error = "cannot create section";
+    }
+
+    if (error.empty() && importSection) {
+      const DxvkHostShareHeader* header = section->header();
+
+      if (requirements.size > section->dataSize()
+       || layout.rowPitch != header->rowPitch
+       || layout.offset != header->imageOffset) {
+        error = str::format("layout differs from the exporter's: row pitch ", layout.rowPitch,
+          " vs ", header->rowPitch, ", offset ", layout.offset, " vs ", header->imageOffset,
+          ", size ", requirements.size, " vs ", section->dataSize(), " (exporter format ", header->vkFormat, ")");
+      }
+    }
+
+    VkMemoryHostPointerPropertiesEXT hostProperties = { VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT };
+
+    if (error.empty()) {
+      vr = vk->vkGetMemoryHostPointerPropertiesEXT(vk->device(),
+        VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, section->data(), &hostProperties);
+
+      if (vr != VK_SUCCESS)
+        error = str::format("vkGetMemoryHostPointerPropertiesEXT: ", vr);
+    }
+
+    // Prefer memory types with the requested properties
+    uint32_t typeMask = requirements.memoryTypeBits & hostProperties.memoryTypeBits;
+
+    if (typeMask & getMemoryTypeMask(allocationInfo.properties))
+      typeMask &= getMemoryTypeMask(allocationInfo.properties);
+
+    if (error.empty() && !typeMask) {
+      error = str::format("no memory type: image ", std::hex, requirements.memoryTypeBits,
+        ", host pointer ", hostProperties.memoryTypeBits);
+    }
+
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    uint32_t typeIndex = typeMask ? bit::tzcnt(typeMask) : 0u;
+
+    if (error.empty()) {
+      VkImportMemoryHostPointerInfoEXT importInfo = { VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT };
+      importInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+      importInfo.pHostPointer = section->data();
+
+      VkMemoryAllocateInfo memoryInfo = { VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &importInfo };
+      memoryInfo.allocationSize = section->dataSize();
+      memoryInfo.memoryTypeIndex = typeIndex;
+
+      if ((vr = vk->vkAllocateMemory(vk->device(), &memoryInfo, nullptr, &memory)))
+        error = str::format("vkAllocateMemory(host pointer, ", section->dataSize(), " bytes, type ", typeIndex, "): ", vr);
+      else if ((vr = vk->vkBindImageMemory(vk->device(), image, memory, 0u)))
+        error = str::format("vkBindImageMemory: ", vr);
+    }
+
+    if (!error.empty()) {
+      if (memory)
+        vk->vkFreeMemory(vk->device(), memory, nullptr);
+
+      vk->vkDestroyImage(vk->device(), image, nullptr);
+
+      throw DxvkError(str::format("Failed to create shared resource in host memory: ", error,
+        "\n  format:  ", createInfo.format,
+        "\n  extent:  ", createInfo.extent.width, "x", createInfo.extent.height,
+        "\n  usage:   ", std::hex, createInfo.usage,
+        "\n  flags:   ", createInfo.flags));
+    }
+
+    // Vulkan side of the header for exports. The API layer
+    // adds its own resource description and sets the magic.
+    if (!importSection) {
+      DxvkHostShareHeader* header = section->header();
+      header->version = DxvkHostShareVersion;
+      header->creator = DxvkHostShareCreatorDxvk;
+      header->vkFormat = createInfo.format;
+      header->width = createInfo.extent.width;
+      header->height = createInfo.extent.height;
+      header->mipLevels = createInfo.mipLevels;
+      header->arraySize = createInfo.arrayLayers;
+      header->sampleCount = uint32_t(createInfo.samples);
+      header->rowPitch = layout.rowPitch;
+      header->imageOffset = layout.offset;
+      header->imageSize = layout.size;
+    }
+
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+    auto& type = m_memTypes[typeIndex];
+
+    DxvkDeviceMemory deviceMemory = { };
+    deviceMemory.memory = memory;
+    deviceMemory.size = section->dataSize();
+    type.stats.memoryAllocated += deviceMemory.size;
+
+    Rc<DxvkResourceAllocation> allocation = createAllocation(type, deviceMemory, allocationInfo);
+    allocation->m_flags.clr(DxvkAllocationFlag::CanMove);
+    allocation->m_flags.set(DxvkAllocationFlag::OwnsImage);
+    allocation->m_image = image;
+
+    // Released in ~DxvkResourceAllocation, after vkFreeMemory
+    allocation->m_hostSection = section.ptr();
+    allocation->m_hostSection->incRef();
+    return allocation;
+  }
