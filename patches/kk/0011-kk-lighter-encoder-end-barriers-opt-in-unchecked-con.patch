 src/kosmickrisp/vulkan/kk_queue.h          |  2 +-
 src/kosmickrisp/vulkan/kk_shader.c         | 21 ++++++++++++++++++++-
 10 files changed, 74 insertions(+), 5 deletions(-)

diff --git a/src/kosmickrisp/bridge/mtl_encoder.h b/src/kosmickrisp/bridge/mtl_encoder.h
index 41c8e127f02..25d2e125e4a 100644
--- a/src/kosmickrisp/bridge/mtl_encoder.h
+++ b/src/kosmickrisp/bridge/mtl_encoder.h
@@ -19,6 +19,9 @@ void mtl_encoder_set_log(bool enabled);
 void mtl_end_encoding(void *encoder);
 void mtl_barrier_after_stages(void *encoder, enum mtl_stages after_stages,
                               enum mtl_stages before_queue_stages);
+void mtl_barrier_after_stages_device(void *encoder,
+                                     enum mtl_stages after_stages,
+                                     enum mtl_stages before_queue_stages);
 void mtl_barrier_after_encoder_stages(void *encoder,
                                       enum mtl_stages after_stages,
                                       enum mtl_stages before_queue_stages);
diff --git a/src/kosmickrisp/bridge/mtl_encoder.m b/src/kosmickrisp/bridge/mtl_encoder.m
index 1148ed2a4e0..5ff79d2fb26 100644
--- a/src/kosmickrisp/bridge/mtl_encoder.m
+++ b/src/kosmickrisp/bridge/mtl_encoder.m
@@ -240,6 +240,17 @@ mtl_barrier_after_stages(void *encoder, enum mtl_stages after_stages,
    }
 }
 
+void
+mtl_barrier_after_stages_device(void *encoder, enum mtl_stages after_stages,
+                                enum mtl_stages before_queue_stages)
+{
+   @autoreleasepool {
+      id<MTL4CommandEncoder> enc = (id<MTL4CommandEncoder>)encoder;
+      [enc barrierAfterStages:(MTLStages)after_stages beforeQueueStages:(MTLStages)before_queue_stages
+           visibilityOptions:MTL4VisibilityOptionDevice];
+   }
+}
+
 void
 mtl_barrier_after_encoder_stages(void *encoder, enum mtl_stages after_stages,
                                  enum mtl_stages before_queue_stages)
diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index ce25e83194c..6d43815dceb 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -22,6 +22,8 @@
 #include "kosmickrisp/bridge/vk_to_mtl_map.h"
 #include "kosmickrisp/compiler/nir_to_msl.h"
 
+#include "util/u_debug.h"
+
 #include "vk_alloc.h"
 #include "vk_common_entrypoints.h"
 #include "vk_format.h"
@@ -565,11 +567,20 @@ end_pre_gfx(struct kk_cmd_buffer *cmd)
    }
 }
 
+DEBUG_GET_ONCE_BOOL_OPTION(hb_alias_barriers, "HB_KK_ALIAS_BARRIERS", false)
+
 static void
 end_encoder(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
 {
    /* TODO_KOSMICKRISP This is probably overkill */
-   mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   const bool is_render = encoder == cmd->metal.render;
+   if ((is_render && cmd->state.gfx.occlusion.used) ||
+       debug_get_option_hb_alias_barriers())
+      mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   else
+      mtl_barrier_after_stages_device(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   if (is_render)
+      cmd->state.gfx.occlusion.used = false;
    mtl_end_encoding(encoder);
    mtl_release(encoder);
 
