 namespace {
@@ -357,6 +367,291 @@ void HandleImageMap(uint64_t Address, bool MainImage = false) {
 void HandleImageUnmap(uint64_t Address, uint64_t Size) {
   ImageTracker->HandleImageUnmap(Address, Size);
 }
+
+// x86 debug register emulation (steamac-dr).
+//
+// Wine's ARM64EC NtSetContextThread/NtGetContextThread convert the x64 CONTEXT to an ARM64_NT_CONTEXT and drop
+// DR0-DR7 (context_x64_to_arm only maps the general purpose state). CodeWeavers' ntdll.dll is not built from source
+// here, so the ARM64EC implementations of those two functions are detoured: DR0-DR7 are kept in FEX thread state and
+// the original function still does everything else. The detour replaces the first four instructions with an absolute
+// branch into a trampoline that replays them and jumps to the rest of the original function, so the detour never has to
+// be removed while other threads may be inside the function.
+namespace DebugRegisters {
+  constexpr uint32_t EFLAGS_RF = 1U << 16;
+  // Bits that an x86 CPU keeps set in DR6 (arch/x86/include/asm/debugreg.h).
+  constexpr uint64_t DR6_RESERVED = 0xFFFF0FF0;
+  constexpr uint64_t Unarmed = ~0ULL;
+  // A breakpoint below the first 64 Ki of the address space can never execute; treating one as armed would invalidate
+  // every JIT block (a NULL-range invalidation covers the whole address space).
+  constexpr uint64_t LowestBreakpointAddress = 0x10000;
+
+  struct Detour {
+    uint8_t* Target {};
+    uint8_t Saved[16] {};
+    uint8_t* Trampoline {};
+    bool Installed {};
+  };
+
+  Detour SetContextDetour;
+  Detour GetContextDetour;
+
+  // The instructions copied into the trampoline must not depend on the address they execute from.
+  bool IsPCRelative(uint32_t Instruction) {
+    return (Instruction & 0x7C000000) == 0x14000000 || // B, BL
+           (Instruction & 0x7E000000) == 0x34000000 || // CBZ, CBNZ
+           (Instruction & 0x7E000000) == 0x36000000 || // TBZ, TBNZ
+           (Instruction & 0x1F000000) == 0x10000000 || // ADR, ADRP
+           (Instruction & 0x3B000000) == 0x18000000;   // LDR (literal), LDRSW, PRFM (literal)
+  }
+
+  void WriteCode(uint8_t* Address, const uint8_t* Bytes, size_t Size) {
+    void* ProtAddress = Address;
+    SIZE_T ProtSize = Size;
+    ULONG OldProtect {};
+    ULONG RestoredProtect {};
+    NtProtectVirtualMemoryNative(NtCurrentProcess(), &ProtAddress, &ProtSize, PAGE_READWRITE, &OldProtect);
+    memcpy(Address, Bytes, Size);
+    // The out pointer must not be NULL: wine's syscall faults on it.
+    NtProtectVirtualMemoryNative(NtCurrentProcess(), &ProtAddress, &ProtSize, OldProtect, &RestoredProtect);
+    __builtin___clear_cache(reinterpret_cast<char*>(Address), reinterpret_cast<char*>(Address) + Size);
+  }
+
+  void WriteJump(uint8_t* Buffer, const void* Destination) {
+    const uint32_t Load = 0x58000050;   // ldr x16, #8
+    const uint32_t Branch = 0xD61F0200; // br x16
+    memcpy(Buffer, &Load, sizeof(Load));
+    memcpy(Buffer + 4, &Branch, sizeof(Branch));
+    memcpy(Buffer + 8, &Destination, sizeof(Destination));
+  }
+
+  // The ARM64EC implementation of an ntdll export: the x64 export is a fast forward sequence, and the ARM64EC metadata
+  // redirection table maps it to the real function.
+  uintptr_t FindNativeEntry(const char* Name) {
+    const auto NtDll = GetModuleHandleW(L"ntdll.dll");
+    const auto FastForward = reinterpret_cast<uintptr_t>(GetProcAddress(NtDll, Name));
+    if (!FastForward) {
+      return 0;
+    }
+
+    const uintptr_t RVA = FastForward - NtDllBase;
+    if (RVA >= NtDllRedirectionLUTSize) {
+      return 0;
+    }
+
+    const uint32_t NativeRVA = NtDllRedirectionLUT[RVA];
+    return NativeRVA ? NtDllBase + NativeRVA : 0;
+  }
+
+  bool Install(Detour* State, uintptr_t Target, void* Hook) {
+    if (!Target) {
+      return false;
+    }
+
+    auto TargetCode = reinterpret_cast<uint8_t*>(Target);
+    memcpy(State->Saved, TargetCode, sizeof(State->Saved));
+    for (size_t i = 0; i < 4; ++i) {
+      uint32_t Instruction {};
+      memcpy(&Instruction, State->Saved + i * 4, sizeof(Instruction));
+      if (IsPCRelative(Instruction)) {
+        return false;
+      }
+    }
+
+    State->Trampoline = reinterpret_cast<uint8_t*>(
+      ::VirtualAlloc(nullptr, FEXCore::Utils::FEX_PAGE_SIZE, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE));
+    if (!State->Trampoline) {
+      LogMan::Msg::EFmt("steamacdr: failed to allocate the trampoline");
+      return false;
+    }
+
+    // Replay the replaced instructions, then continue in the original function.
+    memcpy(State->Trampoline, State->Saved, sizeof(State->Saved));
+    WriteJump(State->Trampoline + sizeof(State->Saved), reinterpret_cast<const void*>(Target + sizeof(State->Saved)));
+    __builtin___clear_cache(reinterpret_cast<char*>(State->Trampoline),
+                            reinterpret_cast<char*>(State->Trampoline) + FEXCore::Utils::FEX_PAGE_SIZE);
+
+    uint8_t Patch[16];
+    WriteJump(Patch, Hook);
+    WriteCode(TargetCode, Patch, sizeof(Patch));
+
+    State->Target = TargetCode;
+    State->Installed = true;
+    LogMan::Msg::IFmt("steamacdr: hooked {:X} -> {:X}", Target, reinterpret_cast<uintptr_t>(Hook));
+    return true;
+  }
+
+  struct SavedDebugState {
+    uint64_t ExecAddr[4] {};
+    uint64_t Dr[4] {};
+    uint64_t Dr6 {};
+    uint64_t Dr7 {};
+  };
+
+  // Called with ThreadCreationMutex held.
+  void ApplyLocked(FEXCore::Core::InternalThreadState* Thread, const CONTEXT* Context, SavedDebugState* Saved) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    const uint64_t DrAddr[4] {Context->Dr0, Context->Dr1, Context->Dr2, Context->Dr3};
+
+    uint64_t ExecAddr[4];
+    {
+      std::scoped_lock Lock(Frontend->DRMutex);
+      if (Saved) {
+        memcpy(Saved->ExecAddr, Thread->CurrentFrame->HWBreakpointExecAddr, sizeof(Saved->ExecAddr));
+        memcpy(Saved->Dr, Frontend->Dr, sizeof(Saved->Dr));
+        Saved->Dr6 = Frontend->Dr6;
+        Saved->Dr7 = Frontend->Dr7;
+      }
+
+      memcpy(Frontend->Dr, DrAddr, sizeof(Frontend->Dr));
+      Frontend->Dr6 = Context->Dr6;
+      Frontend->Dr7 = Context->Dr7;
+
+      for (size_t i = 0; i < 4; ++i) {
+        const uint32_t Enabled = (Context->Dr7 >> (i * 2)) & 0x3; // L and G
+        const uint32_t RW = (Context->Dr7 >> (16 + i * 4)) & 0x3;
+        const uint32_t Len = (Context->Dr7 >> (18 + i * 4)) & 0x3;
