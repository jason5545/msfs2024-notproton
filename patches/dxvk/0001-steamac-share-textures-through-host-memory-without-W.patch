@@ -431,6 +484,60 @@ namespace dxvk {
   }
 
 
+  void DxvkImage::checkHostShareSupport(
+          DxvkDevice*           device,
+    const VkImageCreateInfo&    createInfo) const {
+    const DxvkFormatInfo* formatInfo = lookupFormatInfo(createInfo.format);
+    const char* reason = nullptr;
+
+    // Host memory can only back buffer-like LINEAR images: single 2D
+    // subresource, no planes, no depth. Anything else would silently
+    // end up unshared, so refuse it.
+    if (createInfo.flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT)
+      reason = "sparse resources are not supported";
+    else if (createInfo.imageType != VK_IMAGE_TYPE_2D)
+      reason = "only 2D textures are supported";
+    else if (createInfo.mipLevels != 1)
+      reason = "mip levels > 1 are not supported";
+    else if (createInfo.arrayLayers != 1)
+      reason = "texture arrays are not supported";
+    else if (createInfo.samples != VK_SAMPLE_COUNT_1_BIT)
+      reason = "multisampling is not supported";
+    else if (formatInfo->flags.test(DxvkFormatFlag::MultiPlane))
+      reason = "multi-planar formats are not supported";
+    else if (formatInfo->aspectMask & (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT))
+      reason = "depth-stencil formats are not supported";
+
+    if (!reason) {
+      DxvkFormatQuery formatQuery = { };
+      formatQuery.format = createInfo.format;
+      formatQuery.type = createInfo.imageType;
+      formatQuery.tiling = VK_IMAGE_TILING_LINEAR;
+      formatQuery.usage = createInfo.usage;
+      formatQuery.flags = createInfo.flags;
+      formatQuery.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+
+      auto limits = device->getFormatLimits(formatQuery);
+
+      if (!limits || !(limits->externalFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT))
+        reason = "format, usage or flags not supported for LINEAR host-memory images";
+      else if (createInfo.extent.width > limits->maxExtent.width || createInfo.extent.height > limits->maxExtent.height)
+        reason = "extent too large for a LINEAR image";
+    }
+
+    if (reason) {
+      throw DxvkError(str::format("Failed to create shared resource in host memory: ", reason,
+        "\n  format:  ", createInfo.format,
+        "\n  extent:  ", createInfo.extent.width, "x", createInfo.extent.height, "x", createInfo.extent.depth,
+        "\n  mips:    ", createInfo.mipLevels,
+        "\n  layers:  ", createInfo.arrayLayers,
+        "\n  samples: ", createInfo.samples,
+        "\n  usage:   ", std::hex, createInfo.usage,
+        "\n  flags:   ", createInfo.flags));
+    }
+  }
+
+
 
 
 
