   void InvalidateGuestCodeRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Start, uint64_t Length) override {
+    // Adaptive SMC (steamac r10): with hot pages this is the path of every failed per-instruction validation
+    // (ThreadRemoveCodeEntryFromJit), called from JIT code without locks. The invalidation walks `Threads`, which
+    // needs ThreadCreationMutex; take it (same order as the access violation path: ThreadCreationMutex, then
+    // CodeInvalidationMutex). STEAMAC_SMC_HOT=0 keeps the old unlocked call.
+    if (FEXCore::SteamacSMC::Threshold()) {
+      std::scoped_lock Lock(ThreadCreationMutex);
+      InvalidationTracker->InvalidateAlignedInterval(Start, Length, false);
+      return;
+    }
     InvalidationTracker->InvalidateAlignedInterval(Start, Length, false);
   }
 
