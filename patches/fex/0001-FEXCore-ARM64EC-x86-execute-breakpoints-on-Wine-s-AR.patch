+void OpDispatchBuilder::HWBreakpointCheck(uint64_t EntryOffset) {
+  // x86 debug register emulation (steamac-dr).
+  const auto GPRSize = GetGPROpSize();
+  constexpr uint64_t Unarmed = ~0ULL;
+
+  // Make sure all guest state is in the context before branching to the trap path.
+  FlushRegisterCache();
+
+  auto RIP = _EntrypointOffset(GPRSize, EntryOffset);
+
+  // Hit = any of this thread's armed execute breakpoint slots equals this instruction's address.
+  Ref Hit {};
+  for (size_t i = 0; i < 4; ++i) {
+    auto Addr = _LoadContextGPR(OpSize::i64Bit, offsetof(FEXCore::Core::CpuStateFrame, HWBreakpointExecAddr[i]));
+    Ref Eq = Select01(OpSize::i64Bit, CondClass::EQ, Addr, RIP);
+    Hit = Hit ? Ref(_Or(OpSize::i64Bit, Hit, Eq)) : Eq;
+  }
+
+  // RF: returning to this RIP with EFLAGS.RF=1 skips the instruction breakpoint once. RF is cleared after one
+  // instruction on x86; here the pending RF is consumed by the first breakpoint check that sees it.
+  auto Resume = _LoadContextGPR(OpSize::i64Bit, offsetof(FEXCore::Core::CPUState, HWBreakpointResumeRIP));
+  auto NotSuppressed = Select01(OpSize::i64Bit, CondClass::NEQ, Resume, RIP);
+  _StoreContextGPR(OpSize::i64Bit, Constant(Unarmed), offsetof(FEXCore::Core::CPUState, HWBreakpointResumeRIP));
+
+  auto Trap = _And(OpSize::i64Bit, Hit, NotSuppressed);
+
+  auto TrapCond = CondJump(Trap);
+  auto CurrentBlock = GetCurrentBlock();
+
+  auto TrapBlock = CreateNewCodeBlockAtEnd();
+  SetTrueJumpTarget(TrapCond, TrapBlock);
+  SetCurrentCodeBlock(TrapBlock);
+  StartNewBlock();
+  {
+    // Fault-style: RIP points at the instruction that has not executed yet.
+    _StoreContextGPR(GPRSize, _EntrypointOffset(GPRSize, EntryOffset), offsetof(FEXCore::Core::CPUState, rip));
+    Break(FEXCore::IR::BreakDefinition {
+      .ErrorRegister = 0,
+      .Signal = Core::FAULT_SIGTRAP,
+      .TrapNumber = FEXCore::X86State::X86_TRAPNO_DB,
+      .si_code = 4, // TRAP_HWBKPT
+    });
+  }
+
+  auto NextBlock = CreateNewCodeBlockAfter(CurrentBlock);
+  SetFalseJumpTarget(TrapCond, NextBlock);
+  SetCurrentCodeBlock(NextBlock);
+  StartNewBlock();
+}
