diff --git a/dylib/tests/steamaccheck.sh b/dylib/tests/steamaccheck.sh
new file mode 100644
index 0000000..b481029
--- /dev/null
+++ b/dylib/tests/steamaccheck.sh
@@ -0,0 +1,87 @@
+#!/bin/sh
+# steamac: checks the run script's parts for the components SteamacOverlay lays into the FEX runner,
+# against a fake runner and prefix: the vkd3d backend copies the D3D DLLs, adds the overrides and
+# points Vulkan at KosmicKrisp; every other FEX game keeps CrossOver's MoltenVK through the loader;
+# x86_64 Wine and runners without the overlay are left alone; a new overlay reruns wine.inf once.
+set -u
+SRC=${1:-dylib/feats/compat_run.sh}
+T=$(mktemp -d "${TMPDIR:-/tmp}/steamaccheck.XXXXXX")
+trap 'rm -rf "$T"' EXIT
+fails=0
+is() { if [ "$2" = "$3" ]; then echo "  ok    $1"; else echo "  FAIL  $1"; echo "         want [$2]"; echo "         got  [$3]"; fails=$((fails + 1)); fi; }
+
+backend=$(sed -n '/^np_steamac_d3d=0$/,/^np_dropped=""$/p' "$SRC")
+layer=$(sed -n '/^# steamac: the runner.s Vulkan loader needs a driver/,/^game_cwd=/p' "$SRC" | sed '$d')
+overlay=$(sed -n '/^note_steamac_overlay() {$/,/^}$/p' "$SRC")
+[ -n "$backend" ] && [ -n "$layer" ] && [ -n "$overlay" ] || { echo "==> steamaccheck: could not find the steamac parts of $SRC"; exit 1; }
+
+mkrunner() { # mkrunner <dir> <with overlay 0|1>
+  mkdir -p "$1/lib/aarch64/moltenvk" "$1/lib/steamac/d3d" "$1/lib/steamac/kk"
+  if [ "$2" = 1 ]; then
+    echo '{}' > "$1/lib/aarch64/moltenvk/MoltenVK_icd.json"
+    for d in dxgi d3d11 d3d10core d3d12 d3d12core; do echo "$d new" > "$1/lib/steamac/d3d/$d.dll"; done
+    echo '{}' > "$1/lib/steamac/kk/kosmickrisp_icd.json"
+    echo digest-1 > "$1/.notproton-steamac"
+  else
+    rm -rf "$1/lib/aarch64/moltenvk" "$1/lib/steamac"
+  fi
+}
+# run <wine_unix> <launch env...>: the backend part, then the layer; prints the env lines it set and the overrides
+run() {
+  wu=$1; shift
+  env -i HOME="$HOME" PATH="$PATH" CX_ROOT="$CX" WINEPREFIX="$PFX" log="$T/log" wine_unix="$wu" "$@" sh -c "
+    $backend
+    np_feat_envs=\"\${PLUGIN_ENV-}\"
+    $layer
+    printf 'env:%s\n' \"\$(printf '%s\n' \"\$np_feat_envs\" | sed '/^\$/d' | sort | tr '\n' '|')\"
+    printf 'ovr:%s\n' \"\${WINEDLLOVERRIDES-}\"
+    printf 'cx:%s\n' \"\${CX_GRAPHICS_BACKEND-unset}\""
+}
+
+CX=$T/runner/CrossOver; PFX=$T/pfx
+mkrunner "$CX" 1
+mkdir -p "$PFX/drive_c/windows/system32"; echo "old" > "$PFX/drive_c/windows/system32/d3d12.dll"
+
+echo "== vkd3d backend on the FEX runner =="
+out=$(run /x/aarch64-unix CX_GRAPHICS_BACKEND=vkd3d)
+is "CrossOver gets no backend of ours" "cx:unset" "$(echo "$out" | grep '^cx:')"
+is "the overrides are added" "ovr:d3d12,d3d12core,dxgi,d3d11,d3d10core=n,b" "$(echo "$out" | grep '^ovr:')"
+is "Vulkan goes to KosmicKrisp and vkd3d gets its levels" \
+  "env:DXVK_CONFIG=dxgi.maxDeviceMemory = 16384; dxgi.maxSharedMemory = 8192|VKD3D_FEATURE_LEVEL=12_1|VKD3D_SHADER_MODEL=6_7|VK_DRIVER_FILES=$CX/lib/steamac/kk/kosmickrisp_icd.json|" \
+  "$(echo "$out" | grep '^env:')"
+is "the five DLLs are in system32" "5" "$(grep -l new "$PFX"/drive_c/windows/system32/*.dll | wc -l | tr -d ' ')"
+out=$(run /x/aarch64-unix CX_GRAPHICS_BACKEND=vkd3d NOTPROTON_ENV_VKD3D_FEATURE_LEVEL=12_0)
+is "a launch option keeps its own value" "" "$(echo "$out" | grep '^env:' | grep -o 'VKD3D_FEATURE_LEVEL=12_1')"
+out=$(run /x/aarch64-unix CX_GRAPHICS_BACKEND=vkd3d PLUGIN_ENV="VK_DRIVER_FILES=/elsewhere.json")
+is "a plugin's driver wins" "1" "$(echo "$out" | grep '^env:' | grep -o 'VK_DRIVER_FILES=[^|]*' | wc -l | tr -d ' ')"
+
+echo "== other FEX games =="
+out=$(run /x/aarch64-unix CX_GRAPHICS_BACKEND=dxmt)
+is "the backend stays CrossOver's" "cx:dxmt" "$(echo "$out" | grep '^cx:')"
+is "Vulkan stays on CrossOver's MoltenVK" "env:VK_DRIVER_FILES=$CX/lib/aarch64/moltenvk/MoltenVK_icd.json|" "$(echo "$out" | grep '^env:')"
+is "no overrides" "ovr:" "$(echo "$out" | grep '^ovr:')"
+out=$(run /x/aarch64-unix)
+is "automatic also keeps MoltenVK" "env:VK_DRIVER_FILES=$CX/lib/aarch64/moltenvk/MoltenVK_icd.json|" "$(echo "$out" | grep '^env:')"
+
+echo "== x86_64 Wine and plain runners =="
+out=$(run /x/x86_64-unix CX_GRAPHICS_BACKEND=vkd3d)
+is "x86_64 Wine drops vkd3d" "cx:unset" "$(echo "$out" | grep '^cx:')"
+is "and sets nothing" "env:|ovr:" "$(echo "$out" | grep -E '^(env|ovr):' | tr '\n' '|' | sed 's/|$//')"
+mkrunner "$CX" 0
+out=$(run /x/aarch64-unix)
+is "a runner without the overlay sets nothing" "env:" "$(echo "$out" | grep '^env:')"
+
+echo "== the prefix follows the overlay =="
+mkrunner "$CX" 1
+SC=$T/compat; mkdir -p "$SC"; touch "$PFX/system.reg"; echo 1234 > "$PFX/.update-timestamp"
+note() { env -i PATH="$PATH" CX_ROOT="$CX" WINEPREFIX="$PFX" STEAM_COMPAT_DATA_PATH="$SC" log="$T/log" sh -c "$overlay
+note_steamac_overlay"; }
+note
+is "a new overlay reruns wine.inf" "0" "$(cat "$PFX/.update-timestamp")"
+is "and is recorded" "digest-1" "$(cat "$SC/notproton-steamac")"
+echo 1234 > "$PFX/.update-timestamp"; note
+is "the same overlay does not" "1234" "$(cat "$PFX/.update-timestamp")"
+echo digest-2 > "$CX/.notproton-steamac"; note
+is "a changed one does" "0" "$(cat "$PFX/.update-timestamp")"
+
+[ "$fails" = 0 ] && echo "==> steamaccheck: all assertions hold" || { echo "==> steamaccheck: $fails failed"; exit 1; }
