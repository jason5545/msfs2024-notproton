diff --git a/FEXCore/include/FEXCore/Utils/SteamacSMC.h b/FEXCore/include/FEXCore/Utils/SteamacSMC.h
new file mode 100644
index 000000000..89c7d1e7a
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/SteamacSMC.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <atomic>
+#include <cstdint>
+
+/*
+ * Adaptive per-page SMC handling for SMCChecks=mtrack (steamac r10, ported to the Windows frontends).
+ *
+ * mtrack write-protects every guest page that FEX compiled code from. A guest write to such a page faults; the fault
+ * handler throws away every block compiled from the page in every thread, makes the page writable again, and the next
+ * compile from the page protects it again. A guest that keeps writing data (or code that is not executed in between)
+ * into pages that also hold code it is running pays an exception, two protection changes, a page-wide invalidation
+ * across all threads and recompiles of unchanged code for every such write.
+ *
+ * A page that takes Threshold() write faults within a short window becomes "hot": it is no longer write-protected, and
+ * every instruction compiled from it validates its own guest bytes before it runs (the same per-instruction check as
+ * SMCChecks=full, see GenerateIR). Writes to the page then cost nothing, and code in it is only recompiled when the bytes
+ * of an instruction that is about to run actually changed. A page stays hot for the rest of the process.
+ *
+ * The frontend calls NoteFault for every SMC write fault, before it invalidates the page, and leaves hot pages out when
+ * it protects pages again. Threshold() comes from STEAMAC_SMC_HOT (default 8, 0 disables). The tables are fixed-size and
+ * lock-free (async-signal-safe on Linux, where NoteFault runs in the SIGSEGV handler); when the hot table is full no
+ * further pages become hot.
+ */
+namespace FEXCore::SteamacSMC {
+FEX_DEFAULT_VISIBILITY uint32_t Threshold();
+// SMC write fault on a guest page (page number = address >> 12): 0 = not hot, 1 = became hot with this fault,
+// 2 = was already hot (should not happen: hot pages are not write-protected).
+FEX_DEFAULT_VISIBILITY int NoteFault(uint64_t Page);
+FEX_DEFAULT_VISIBILITY bool IsHot(uint64_t Page);
+FEX_DEFAULT_VISIBILITY uint32_t HotCount();
+// Milliseconds from a monotonic clock that is safe to read anywhere (signal handlers, exception callbacks).
+FEX_DEFAULT_VISIBILITY uint32_t NowMs();
+
+inline bool AnyHot() {
+  return HotCount() != 0;
+}
+// True if any byte of [Address, Address + Size) is on a hot page.
+inline bool RangeIsHot(uint64_t Address, uint64_t Size) {
+  if (!AnyHot() || !Size) {
+    return false;
+  }
+  for (uint64_t Page = Address >> 12, Last = (Address + Size - 1) >> 12; Page <= Last; ++Page) {
+    if (IsHot(Page)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Process-wide counters for STEAMAC_SMCSTATS=1 (the Windows frontends print them once a second). Plain relaxed atomics:
+// thread_local is not usable in the ARM64EC module (its TLS slot is not set up).
+struct Counters {
+  std::atomic<uint64_t> Faults;            // SMC write faults handled by the frontend
+  std::atomic<uint64_t> BecameHot;         // ... that made their page hot
+  std::atomic<uint64_t> OnHot;             // ... on a page that was already hot
+  std::atomic<uint64_t> ValidateMiss;      // per-instruction validation found changed bytes (SMCChecks=full or hot page)
+  std::atomic<uint64_t> ReprotectSkipped;  // pages left writable when the frontend protected code pages again
+  std::atomic<uint64_t> Invalidations;     // frontend invalidations of guest ranges
+  std::atomic<uint64_t> InvalidationsNoCode; // ... with no compiled code in the range (per-thread walk skipped)
+};
+FEX_DEFAULT_VISIBILITY bool StatsEnabled();
+FEX_DEFAULT_VISIBILITY Counters& Stats();
+} // namespace FEXCore::SteamacSMC
