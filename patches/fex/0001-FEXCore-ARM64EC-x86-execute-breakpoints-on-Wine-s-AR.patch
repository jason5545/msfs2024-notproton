+  }
+
+  // Called with ThreadCreationMutex held.
+  void RestoreLocked(FEXCore::Core::InternalThreadState* Thread, const SavedDebugState& Saved) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    {
+      std::scoped_lock Lock(Frontend->DRMutex);
+      memcpy(Frontend->Dr, Saved.Dr, sizeof(Frontend->Dr));
+      Frontend->Dr6 = Saved.Dr6;
+      Frontend->Dr7 = Saved.Dr7;
+    }
+    Thread->CTX->SetGuestHWBreakpoints(Thread, Saved.ExecAddr);
+  }
+
+  FEXCore::Core::InternalThreadState* LookupLocked(HANDLE Thread) {
+    THREAD_BASIC_INFORMATION Info;
+    if (NtQueryInformationThread(Thread, ThreadBasicInformation, &Info, sizeof(Info), nullptr)) {
+      return nullptr;
+    }
+
+    const auto TID = static_cast<DWORD>(reinterpret_cast<uintptr_t>(Info.ClientId.UniqueThread));
+    auto it = Threads.find(TID);
+    return it == Threads.end() ? nullptr : it->second;
+  }
+
+  void SaveContextDebugRegisters(FEXCore::Core::InternalThreadState* Thread, CONTEXT* Context) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    std::scoped_lock Lock(Frontend->DRMutex);
+    Context->Dr0 = Frontend->Dr[0];
+    Context->Dr1 = Frontend->Dr[1];
+    Context->Dr2 = Frontend->Dr[2];
+    Context->Dr3 = Frontend->Dr[3];
+    Context->Dr6 = Frontend->Dr6;
+    Context->Dr7 = Frontend->Dr7;
+    Context->ContextFlags |= CONTEXT_DEBUG_REGISTERS;
+  }
+
+  // Called on the faulting thread from ResetToConsistentState, after Wine converted the ARM64 context back to x64 and
+  // before the guest exception handlers see it.
+  void FillExceptionContext(FEXCore::Core::InternalThreadState* Thread, CONTEXT* Context) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    uint64_t Dr[4], Dr7;
+    {
+      std::scoped_lock Lock(Frontend->DRMutex);
+      Frontend->DebugTrapPending = false;
+      memcpy(Dr, Frontend->Dr, sizeof(Dr));
+      Dr7 = Frontend->Dr7;
+      Frontend->Dr6 = DR6_RESERVED;
+      for (size_t i = 0; i < 4; ++i) {
+        if (Thread->CurrentFrame->HWBreakpointExecAddr[i] == Context->Rip) {
+          Frontend->Dr6 |= 1ULL << i;
+        }
+      }
+      Context->Dr6 = Frontend->Dr6;
+    }
+
+    Context->Dr0 = Dr[0];
+    Context->Dr1 = Dr[1];
+    Context->Dr2 = Dr[2];
+    Context->Dr3 = Dr[3];
+    Context->Dr7 = Dr7;
+    // An execute breakpoint is a fault: the instruction has not run. Report RF so that returning to the same RIP does
+    // not immediately hit the same breakpoint again (x86 clears RF after one instruction).
+    Context->EFlags |= EFLAGS_RF;
+    Context->ContextFlags |= CONTEXT_DEBUG_REGISTERS;
+
+    Thread->CurrentFrame->State.HWBreakpointResumeRIP = Context->Rip;
+  }
+
+  bool TakePendingTrap(FEXCore::Core::InternalThreadState* Thread) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    std::scoped_lock Lock(Frontend->DRMutex);
+    const bool Pending = Frontend->DebugTrapPending;
+    return Pending;
+  }
+
+  void MarkPendingTrap(FEXCore::Core::InternalThreadState* Thread) {
+    auto* Frontend = GetFrontendThreadData(Thread);
+    std::scoped_lock Lock(Frontend->DRMutex);
+    Frontend->DebugTrapPending = true;
+  }
+
+  extern "C" NTSTATUS SetContextHook(HANDLE Thread, const CONTEXT* Context) {
+    auto Original = reinterpret_cast<NTSTATUS (*)(HANDLE, const CONTEXT*)>(SetContextDetour.Trampoline);
+
+    bool Applied = false;
+    SavedDebugState Saved {};
+    if ((Context->ContextFlags & CONTEXT_DEBUG_REGISTERS) == CONTEXT_DEBUG_REGISTERS) {
+      std::scoped_lock Lock(ThreadCreationMutex);
+      if (auto* ThreadState = LookupLocked(Thread)) {
+        ApplyLocked(ThreadState, Context, &Saved);
+        Applied = true;
+      } else {
+        LogMan::Msg::DFmt("steamacdr: SetThreadContext on a thread without FEX state");
+      }
+    }
+
+    const NTSTATUS Result = Original(Thread, Context);
+    if (Applied && Result < 0) {
+      // Match x86: a failed NtSetContextThread leaves the debug registers untouched.
+      std::scoped_lock Lock(ThreadCreationMutex);
+      if (auto* ThreadState = LookupLocked(Thread)) {
+        RestoreLocked(ThreadState, Saved);
+      }
+    }
+    return Result;
+  }
+
+  extern "C" NTSTATUS GetContextHook(HANDLE Thread, CONTEXT* Context) {
+    auto Original = reinterpret_cast<NTSTATUS (*)(HANDLE, CONTEXT*)>(GetContextDetour.Trampoline);
+
+    const bool WantsDebugRegisters = (Context->ContextFlags & CONTEXT_DEBUG_REGISTERS) == CONTEXT_DEBUG_REGISTERS;
+    const NTSTATUS Result = Original(Thread, Context);
+    if (Result < 0 || !WantsDebugRegisters) {
+      return Result;
+    }
+
+    std::scoped_lock Lock(ThreadCreationMutex);
+    if (auto* ThreadState = LookupLocked(Thread)) {
+      SaveContextDebugRegisters(ThreadState, Context);
+    }
+    return Result;
+  }
+
+  void Install() {
+    const uintptr_t SetEntry = FindNativeEntry("NtSetContextThread");
+    const uintptr_t GetEntry = FindNativeEntry("NtGetContextThread");
+
+    if (!Install(&SetContextDetour, SetEntry, reinterpret_cast<void*>(&SetContextHook))) {
+      LogMan::Msg::EFmt("steamacdr: NtSetContextThread detour not installed");
+    }
+    if (!Install(&GetContextDetour, GetEntry, reinterpret_cast<void*>(&GetContextHook))) {
+      LogMan::Msg::EFmt("steamacdr: NtGetContextThread detour not installed");
+    }
+  }
