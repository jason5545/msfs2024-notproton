+struct vkd3d_host_share_header
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t header_size;
+    uint32_t creator;
+    uint64_t data_offset;
+    uint64_t data_size;
+    uint32_t dxgi_format;
