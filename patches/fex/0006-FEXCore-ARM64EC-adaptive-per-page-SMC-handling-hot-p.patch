+namespace FEXCore::SteamacSMC {
+// Adaptive per-page SMC handling (steamac r10, Windows port), see FEXCore/Utils/SteamacSMC.h.
+namespace {
+  constexpr size_t HotSlots = 8192; // power of two; at most HotSlots / 2 pages are made hot
+  constexpr size_t MaxProbes = 64;
+  std::atomic<uint64_t> HotTable[HotSlots]; // page + 1, 0 = empty slot
+  std::atomic<uint32_t> NumHot {0};
+
+  // Fault counters: open addressing over CounterWays slots. A direct-mapped table is not enough: two pages that both
+  // fault all the time and share a slot keep restarting each other's count and never become hot (r10 h1: ~1,000
+  // faults/s left on such pairs). A page takes its own slot, an empty or expired one, or else the one with the lowest
+  // count among its CounterWays candidates. Races between threads only make the counts approximate.
+  constexpr size_t CounterSlots = 16384; // power of two
+  constexpr size_t CounterWays = 8;
+  struct FaultCounter {
+    std::atomic<uint64_t> Page; // page + 1, 0 = empty
+    std::atomic<uint32_t> Count;
+    std::atomic<uint32_t> WindowStartMs;
+  };
+  FaultCounter FaultCounters[CounterSlots];
+  constexpr uint32_t WindowMs = 2000;
+
+  // Read once from the environment. No function-local statics: keep it to plain atomics (-1 = not read yet).
+  std::atomic<int64_t> CachedThreshold {-1};
+  std::atomic<int32_t> CachedStatsEnabled {-1};
+  Counters StatsCounters {};
+
+  size_t Mix(uint64_t Page) {
+    return static_cast<size_t>((Page * 0x9E3779B97F4A7C15ULL) >> 32);
+  }
+
+  bool Insert(uint64_t Page) {
+    const uint64_t Key = Page + 1;
+    if (NumHot.load(std::memory_order_relaxed) >= HotSlots / 2) {
+      return false;
+    }
+    for (size_t i = 0, Slot = Mix(Page); i < MaxProbes; ++i, ++Slot) {
+      auto& Entry = HotTable[Slot & (HotSlots - 1)];
+      uint64_t Current = Entry.load(std::memory_order_acquire);
+      if (Current == Key) {
+        return true;
+      }
+      if (Current == 0) {
+        if (Entry.compare_exchange_strong(Current, Key, std::memory_order_acq_rel)) {
+          NumHot.fetch_add(1, std::memory_order_release);
+          return true;
+        }
+        if (Current == Key) {
+          return true;
+        }
+      }
+    }
+    return false;
+  }
+} // namespace
+
+uint32_t NowMs() {
+#ifdef ARCHITECTURE_arm64
+  // The generic timer: no syscall, no locks, fine in signal handlers and in Wine's exception callbacks.
+  uint64_t Count, Frequency;
+  __asm volatile("mrs %0, cntvct_el0" : "=r"(Count));
+  __asm volatile("mrs %0, cntfrq_el0" : "=r"(Frequency));
+  return Frequency >= 1000 ? static_cast<uint32_t>(Count / (Frequency / 1000)) : 0;
+#else
+  return static_cast<uint32_t>(
+    std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+#endif
+}
+
+uint32_t Threshold() {
+  int64_t Value = CachedThreshold.load(std::memory_order_relaxed);
+  if (Value < 0) [[unlikely]] {
+    const char* Env = getenv("STEAMAC_SMC_HOT");
+    Value = (!Env || !Env[0]) ? 8 : static_cast<int64_t>(strtoul(Env, nullptr, 0) & 0xFFFFFFFFU);
+    CachedThreshold.store(Value, std::memory_order_relaxed);
+  }
+  return static_cast<uint32_t>(Value);
+}
+
+bool StatsEnabled() {
+  int32_t Value = CachedStatsEnabled.load(std::memory_order_relaxed);
+  if (Value < 0) [[unlikely]] {
+    const char* Env = getenv("STEAMAC_SMCSTATS");
+    Value = Env && Env[0] == '1';
+    CachedStatsEnabled.store(Value, std::memory_order_relaxed);
+  }
+  return Value != 0;
+}
+
+Counters& Stats() {
+  return StatsCounters;
+}
+
+uint32_t HotCount() {
+  return NumHot.load(std::memory_order_acquire);
+}
+
+bool IsHot(uint64_t Page) {
+  if (!HotCount()) {
+    return false;
+  }
+  const uint64_t Key = Page + 1;
+  for (size_t i = 0, Slot = Mix(Page); i < MaxProbes; ++i, ++Slot) {
+    const uint64_t Current = HotTable[Slot & (HotSlots - 1)].load(std::memory_order_acquire);
+    if (Current == Key) {
+      return true;
+    }
+    if (Current == 0) {
+      return false;
+    }
+  }
+  return false;
+}
+
+int NoteFault(uint64_t Page) {
+  const uint32_t Limit = Threshold();
+  if (!Limit) {
+    return 0;
+  }
+  if (IsHot(Page)) {
+    return 2;
+  }
+  const uint64_t Key = Page + 1;
+  const uint32_t Now = NowMs();
+  const size_t Base = Mix(Page);
+  FaultCounter* Own = nullptr;
+  FaultCounter* Victim = nullptr;
+  uint32_t VictimCount = ~0U;
+  for (size_t i = 0; i < CounterWays; ++i) {
+    auto& C = FaultCounters[(Base + i) & (CounterSlots - 1)];
+    const uint64_t P = C.Page.load(std::memory_order_relaxed);
+    if (P == Key) {
+      Own = &C;
+      break;
+    }
+    const bool Free = P == 0 || Now - C.WindowStartMs.load(std::memory_order_relaxed) > WindowMs;
+    const uint32_t Count = Free ? 0 : C.Count.load(std::memory_order_relaxed);
+    if (Count < VictimCount) {
+      Victim = &C;
+      VictimCount = Count;
+    }
+  }
+  if (Own && Now - Own->WindowStartMs.load(std::memory_order_relaxed) <= WindowMs) {
+    if (Own->Count.fetch_add(1, std::memory_order_relaxed) + 1 >= Limit) {
+      return Insert(Page) ? 1 : 0;
+    }
+    return 0;
+  }
+  // New window: in the page's own (expired) slot, or in the victim slot.
+  FaultCounter& C = Own ? *Own : *Victim;
+  C.Page.store(Key, std::memory_order_relaxed);
+  C.WindowStartMs.store(Now, std::memory_order_relaxed);
+  C.Count.store(1, std::memory_order_relaxed);
+  return (Limit <= 1 && Insert(Page)) ? 1 : 0;
+}
+} // namespace FEXCore::SteamacSMC
