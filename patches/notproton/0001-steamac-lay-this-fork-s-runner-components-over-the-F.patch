@@ -0,0 +1,110 @@
+import Foundation
+import Testing
+
+@testable import NotProtonApp
+
+@Suite("steamac runner overlay")
+struct SteamacOverlayTests {
+
+    private static let build = RunnerBuild(
+        bundleVersion: "27.0.0.41073", releaseVersion: "20261015", flavor: "fex",
+        loaderSHA256: "", cleanNtdll: [:], patchedNtdll: [:])
+
+    private struct Fixture {
+        let base: URL
+        var payload: URL { base.appending(path: "payload") }
+        var root: URL { base.appending(path: "CrossOver") }
+
+        func write(_ text: String, _ rel: String, under top: URL) throws {
+            let url = top.appending(path: rel)
+            try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+            try Data(text.utf8).write(to: url)
+        }
+        func read(_ rel: String) -> String? {
+            (try? Data(contentsOf: root.appending(path: rel))).map { String(decoding: $0, as: UTF8.self) }
+        }
+        func exists(_ rel: String) -> Bool {
+            FileManager.default.fileExists(atPath: root.appending(path: rel).path(percentEncoded: false))
+        }
+    }
+
+    private static func fixture(build: String = "27.0.0.41073-fex") throws -> Fixture {
+        let f = Fixture(base: URL(filePath: NSTemporaryDirectory()).appending(path: "steamac-\(UUID().uuidString)"))
+        let sc = f.payload.appending(path: "steamac")
+        try f.write(build + "\n", "build", under: sc)
+        try f.write("lib/wine/aarch64-unix/libarm64ecfex.so\n", "remove", under: sc)
+        try f.write("our fex", "runner/lib/wine/aarch64-windows/xtajit64.dll", under: sc)
+        try f.write("vulkan loader", "runner/lib/aarch64/libMoltenVK.dylib", under: sc)
+        try f.write("kk", "runner/lib/steamac/kk/libvulkan_kosmickrisp.dylib", under: sc)
+        try f.write("cw fex", "lib/wine/aarch64-windows/xtajit64.dll", under: f.root)
+        try f.write("cw unixlib", "lib/wine/aarch64-unix/libarm64ecfex.so", under: f.root)
+        try f.write("moltenvk", "lib/aarch64/libMoltenVK.dylib", under: f.root)
+        return f
+    }
+
+    @Test("Lays the tree over the runner, keeps what it replaces and moves MoltenVK aside")
+    func installs() throws {
+        let f = try Self.fixture()
+        defer { try? FileManager.default.removeItem(at: f.base) }
+
+        #expect(!SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+        let written = try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload)
+        #expect(written.contains("lib/wine/aarch64-windows/xtajit64.dll"))
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll") == "our fex")
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll.notproton-orig") == "cw fex")
+        #expect(f.read("lib/aarch64/libMoltenVK.dylib") == "vulkan loader")
+        #expect(f.read("lib/aarch64/moltenvk/libMoltenVK.dylib") == "moltenvk")
+        #expect(f.read("lib/aarch64/moltenvk/MoltenVK_icd.json")?.contains("./libMoltenVK.dylib") == true)
+        #expect(f.read("lib/steamac/kk/libvulkan_kosmickrisp.dylib") == "kk")
+        #expect(!f.exists("lib/wine/aarch64-unix/libarm64ecfex.so"))
+        #expect(f.read("lib/wine/aarch64-unix/libarm64ecfex.so.notproton-orig") == "cw unixlib")
+        #expect(f.exists(SteamacOverlay.stampName))
+        #expect(SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+    }
+
+    @Test("A second install writes nothing and keeps CrossOver's MoltenVK, not the loader")
+    func idempotent() throws {
+        let f = try Self.fixture()
+        defer { try? FileManager.default.removeItem(at: f.base) }
+        _ = try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload)
+        #expect(try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+        #expect(f.read("lib/aarch64/moltenvk/libMoltenVK.dylib") == "moltenvk")
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll.notproton-orig") == "cw fex")
+    }
+
+    @Test("A changed component is reported, then replaced, and the record moves on")
+    func updates() throws {
+        let f = try Self.fixture()
+        defer { try? FileManager.default.removeItem(at: f.base) }
+        _ = try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload)
+        let first = f.read(SteamacOverlay.stampName)
+        try f.write("our fex v2", "steamac/runner/lib/wine/aarch64-windows/xtajit64.dll", under: f.payload)
+        #expect(SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload)
+            .contains { $0.contains("xtajit64.dll is out of date") })
+        #expect(try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload)
+            == ["lib/wine/aarch64-windows/xtajit64.dll"])
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll") == "our fex v2")
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll.notproton-orig") == "cw fex")
+        #expect(f.read(SteamacOverlay.stampName) != first)
+        #expect(SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+    }
+
+    @Test("Another runner build is left alone")
+    func otherBuild() throws {
+        let f = try Self.fixture(build: "27.0.0.41069-fex")
+        defer { try? FileManager.default.removeItem(at: f.base) }
+        #expect(try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+        #expect(SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+        #expect(f.read("lib/wine/aarch64-windows/xtajit64.dll") == "cw fex")
+        #expect(!f.exists(SteamacOverlay.stampName))
+    }
+
+    @Test("A payload without steamac does nothing")
+    func noPayload() throws {
+        let f = try Self.fixture()
+        defer { try? FileManager.default.removeItem(at: f.base) }
+        try FileManager.default.removeItem(at: f.payload.appending(path: "steamac"))
+        #expect(try SteamacOverlay.install(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+        #expect(SteamacOverlay.verify(build: Self.build, root: f.root, payload: f.payload).isEmpty)
+    }
+}
diff --git a/dylib/feats/compat_run.sh b/dylib/feats/compat_run.sh
index a5a76c5..14de21b 100755
--- a/dylib/feats/compat_run.sh
+++ b/dylib/feats/compat_run.sh
@@ -1019,6 +1019,8 @@ if [ "$verb" = waitforexitandrun ] && [ -f "$np_defaults_file" ] && [ -r "$np_de
     value=${line#*=}
     case "$line" in
       CX_GRAPHICS_BACKEND=dxmt | CX_GRAPHICS_BACKEND=dxvk | CX_GRAPHICS_BACKEND=wined3d) ;;
+      CX_GRAPHICS_BACKEND=vkd3d)
+        [ "${wine_unix##*/}" = aarch64-unix ] || continue ;;
       CX_GRAPHICS_BACKEND=d3dmetal | D3DM_ENABLE_METALFX=[01] | ROSETTA_ADVERTISE_AVX=[01])
         [ "${wine_unix##*/}" != aarch64-unix ] || continue ;;
       FEX_X87REDUCEDPRECISION=[01])
@@ -1077,6 +1079,19 @@ if [ "$verb" = waitforexitandrun ] && [ -f "$np_defaults_file" ] && [ -r "$np_de
 fi
 [ "${CX_GRAPHICS_BACKEND-}" != auto ] || unset -v CX_GRAPHICS_BACKEND
 
+# steamac: "vkd3d" is not a CrossOver backend. It picks the DXVK/vkd3d-proton DLLs and
+# KosmicKrisp this fork lays into the FEX runner (lib/steamac, see SteamacOverlay.swift);
+# CrossOver itself stays on its automatic choice, which the native DLLs override.
+np_steamac_d3d=0
+if [ "${CX_GRAPHICS_BACKEND-}" = vkd3d ]; then
+  unset -v CX_GRAPHICS_BACKEND
+  if [ "${wine_unix##*/}" = aarch64-unix ]; then
+    np_steamac_d3d=1
+  else
+    echo "steamac: the vkd3d backend needs the FEX runner, ignored on x86_64 Wine" >> "$log" 2>&1 || true
+  fi
+fi
+
 np_dropped=""
 if [ "${wine_unix##*/}" = aarch64-unix ]; then
   if [ "${CX_GRAPHICS_BACKEND:-}" = d3dmetal ]; then
@@ -1492,6 +1507,23 @@ note_variant_switch() {
   fi
 }
 
+# steamac: SteamacOverlay.swift writes a digest of what it laid into the runner. Wine only
+# refreshes a prefix's system32 copies when wine.inf reruns, so a new digest reruns it once.
+note_steamac_overlay() {
+  record="$STEAM_COMPAT_DATA_PATH/notproton-steamac"
+  had=$(cat "$record" 2>/dev/null || true)
+  now=$(cat "$CX_ROOT/.notproton-steamac" 2>/dev/null || true)
+  if [ "$had" != "$now" ] && [ -f "$WINEPREFIX/system.reg" ]; then
+    printf '0\n' > "$WINEPREFIX/.update-timestamp" 2>/dev/null || true
+    echo "=== steamac runner files changed (${had:-none} to ${now:-none}), wine.inf reruns ===" >> "$log" 2>&1 || true
+  fi
+  if [ -n "$now" ]; then
+    printf '%s\n' "$now" > "$record" 2>/dev/null || true
+  else
+    rm -f "$record"
+  fi
+}
+
 claim_prefix() {
   [ -r "$STEAM_COMPAT_DATA_PATH/notproton-build" ] \
     || echo "=== prefix claimed by build $np_build ===" >> "$log" 2>&1 || true
@@ -2396,6 +2428,7 @@ if [ -n "$STEAM_COMPAT_DATA_PATH" ]; then
   refuse_foreign_prefix
   claim_prefix
   note_variant_switch
+  note_steamac_overlay
   stage_step="prefix switch check"
   offer_switch_rebuild
