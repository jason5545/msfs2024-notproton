diff --git a/src/kosmickrisp/compiler/nir_to_msl.c b/src/kosmickrisp/compiler/nir_to_msl.c
index 6ba5818..df73fc4 100644
--- a/src/kosmickrisp/compiler/nir_to_msl.c
+++ b/src/kosmickrisp/compiler/nir_to_msl.c
@@ -126,10 +126,19 @@ emit_inputs(struct nir_to_msl_ctx *ctx, nir_shader *shader)
    P_IND(ctx, "constant SamplerTable &sampler_table [[buffer(1)]]");
    if (ctx->uses_per_draw_data) {
       P(ctx, ",\n");
-      P_IND(ctx, "constant Buffer &per_draw [[buffer(2)]]\n");
-   } else {
-      P(ctx, "\n");
